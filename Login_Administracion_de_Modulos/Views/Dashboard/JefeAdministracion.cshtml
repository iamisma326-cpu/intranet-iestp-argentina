@section Scripts {
    <script>
        function mostrarSeccionAdminTaller(seccionId, navElement) {
            // 1. Quitar estado active de todos los enlaces de navegación de administracion
            const links = document.querySelectorAll('.nav-item-admin-taller');
            links.forEach(l => l.classList.remove('active'));

            // 2. Activar el enlace seleccionado
            if (navElement) {
                navElement.classList.add('active');
            }

            // 3. Ocultar todas las secciones
            const secciones = document.querySelectorAll('.admin-taller-section');
            secciones.forEach(s => s.style.display = 'none');

            // 4. Mostrar la sección seleccionada si existe o la sección genérica informativa
            const target = document.getElementById(seccionId);
            if (target) {
                target.style.display = 'block';
            } else {
                const generico = document.getElementById('seccion-adm-generico');
                if (generico) {
                    generico.style.display = 'block';
                    const navText = navElement ? navElement.querySelector('.nav-text')?.innerText : 'Módulo';
                    document.getElementById('adm-generico-titulo').innerText = navText;
                    document.getElementById('adm-generico-desc').innerText = 'Operatividad del submódulo ' + navText + ' para el área de Administración de Empresas.';
                }
            }
        }

        function toggleDropdownAdminTaller(groupId) {
            const group = document.getElementById(groupId);
            if (group) {
                group.classList.toggle('open');
            }
        }
    </script>
}
