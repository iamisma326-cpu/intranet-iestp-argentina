@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Secretaría Académica";
    ViewData["Role"] = "Secretaría Académica";
}

@section SidebarNav {
    <a href="javascript:void(0)" class="nav-item active" id="nav-sec-dash" onclick="mostrarSeccionSecretaria('seccion-sec-dash', this)">
        <i class="ph ph-squares-four"></i>
        <span>Dashboard</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-sec-personas" onclick="mostrarSeccionSecretaria('seccion-sec-personas', this)">
        <i class="ph ph-users"></i>
        <span>Padrón de Personas</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-sec-especialidad" onclick="mostrarSeccionSecretaria('seccion-sec-especialidad', this)">
        <i class="ph ph-graduation-cap"></i>
        <span>Especialidades</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-sec-matriculas" onclick="mostrarSeccionSecretaria('seccion-sec-matriculas', this)">
        <i class="ph ph-identification-card"></i>
        <span>Matrículas y Trámites</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-sec-certificados" onclick="mostrarSeccionSecretaria('seccion-sec-certificados', this)">
        <i class="ph ph-file-text"></i>
        <span>Certificados</span>
    </a>
    <a href="javascript:void(0)" class="nav-item" id="nav-sec-reportes" onclick="mostrarSeccionSecretaria('seccion-sec-reportes', this)">
        <i class="ph ph-chart-pie-slice"></i>
        <span>Reportes Generales</span>
    </a>
    <a href="/Modulo05/Enfermeria/Panel" class="nav-item" id="nav-sec-topico">
        <i class="ph ph-first-aid"></i>
        <span>Tópico de Salud (M05)</span>
    </a>
    <a href="/Modulo05/Psicologia/Panel" class="nav-item" id="nav-sec-psico">
        <i class="ph ph-brain"></i>
        <span>Bienestar / Psicología (M05)</span>
    </a>
}

<div class="page-header">
    <h1>Secretaría Académica</h1>
    <p>Gestión de padrón institucional, carreras profesionales y trámites académicos (bd.sql)</p>
    <div class="header-accent"></div>
</div>

<div id="seccion-sec-dash" class="sec-section active-section">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background-color: rgba(0, 242, 254, 0.1); color: var(--accent-cyan); display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="ph ph-users"></i>
            </div>
            <div>
                <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Personas Registradas (personas)</p>
                <h3 style="font-size: 1.6rem; font-weight: 700; color: #fff;">1,420</h3>
            </div>
        </div>

        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background-color: rgba(16, 185, 129, 0.1); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="ph ph-graduation-cap"></i>
            </div>
            <div>
                <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Especialidades Activas (especialidad)</p>
                <h3 style="font-size: 1.6rem; font-weight: 700; color: #fff;">6 Carreras</h3>
            </div>
        </div>

        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background-color: rgba(245, 158, 11, 0.1); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="ph ph-identification-card"></i>
            </div>
            <div>
                <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600;">Trámites en Trámite</p>
                <h3 style="font-size: 1.6rem; font-weight: 700; color: #fff;">14 Solicitudes</h3>
            </div>
        </div>
    </div>

    <!-- Padrón de Personas Muestra (Tabla: personas) -->
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem;">
        <h3 style="font-size: 1.1rem; font-weight: 600; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
            <i class="ph ph-address-book" style="color: var(--accent-cyan);"></i> Padrón General de Personas (Tabla: personas)
        </h3>
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-secondary);">
                    <th style="padding: 0.75rem 0.5rem;">Tipo Doc</th>
                    <th style="padding: 0.75rem 0.5rem;">N° Documento</th>
                    <th style="padding: 0.75rem 0.5rem;">Nombres y Apellidos</th>
                    <th style="padding: 0.75rem 0.5rem;">Estado</th>
                    <th style="padding: 0.75rem 0.5rem; text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td style="padding: 0.75rem 0.5rem;">DNI</td>
                    <td style="padding: 0.75rem 0.5rem; font-weight: 600; color: var(--accent-cyan);">72948192</td>
                    <td style="padding: 0.75rem 0.5rem; font-weight: 500;">Ana María Torres Castro</td>
                    <td style="padding: 0.75rem 0.5rem;"><span style="color: #10b981; font-weight: 600;">Activo</span></td>
                    <td style="padding: 0.75rem 0.5rem; text-align: right;">
                        <span style="display: inline-block; padding: 0.35rem 0.75rem; border-radius: 6px; background-color: rgba(0, 242, 254, 0.1); color: var(--accent-cyan); font-weight: 600; font-size: 0.75rem; cursor: pointer;">Ver Ficha</span>
                    </td>
                </tr>
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td style="padding: 0.75rem 0.5rem;">DNI</td>
                    <td style="padding: 0.75rem 0.5rem; font-weight: 600; color: var(--accent-cyan);">40192834</td>
                    <td style="padding: 0.75rem 0.5rem; font-weight: 500;">Carlos Eduardo Docente Mendoza</td>
                    <td style="padding: 0.75rem 0.5rem;"><span style="color: #10b981; font-weight: 600;">Activo</span></td>
                    <td style="padding: 0.75rem 0.5rem; text-align: right;">
                        <span style="display: inline-block; padding: 0.35rem 0.75rem; border-radius: 6px; background-color: rgba(0, 242, 254, 0.1); color: var(--accent-cyan); font-weight: 600; font-size: 0.75rem; cursor: pointer;">Ver Ficha</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    function mostrarSeccionSecretaria(idSeccion, el) {
        document.querySelectorAll('.sec-section').forEach(sec => sec.style.display = 'none');
        document.querySelectorAll('.sidebar-nav .nav-item').forEach(item => item.classList.remove('active'));
        
        var objetivo = document.getElementById(idSeccion);
        if (objetivo) {
            objetivo.style.display = 'block';
        } else {
            document.getElementById('seccion-sec-dash').style.display = 'block';
        }

        if (el) el.classList.add('active');
    }
</script>
