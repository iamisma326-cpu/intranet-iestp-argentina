@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Tesorería - Trámites y Matrícula";
    ViewData["Role"] = "Tesorería";
}

@section SidebarNav {
    <!-- Encabezado Institucional: Trámites y Matrícula -->
    <div class="sidebar-brand-box" style="border-color: rgba(245, 158, 11, 0.25); margin-bottom: 0.75rem;">
        <div class="brand-icon-wrap" style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.35); color: #f59e0b;">
            <i class="ph-fill ph-shield-check"></i>
        </div>
        <div class="brand-details">
            <h5 style="color: #fff; font-size: 0.85rem; margin: 0; font-weight: 700;">IESTP "Argentina"</h5>
            <p style="color: #fbbf24; font-size: 0.7rem; margin: 2px 0 0 0;">Trámites y Matrícula</p>
        </div>
    </div>

    <!-- Lista de Botones del Panel Lateral (Estilo Oscuro Oficial) -->
    <a href="javascript:void(0)" class="nav-item active" id="nav-tes-inicio" onclick="mostrarSeccionTesoreria('seccion-tes-inicio', this)">
        <i class="ph ph-house"></i>
        <span>Inicio</span>
    </a>

    <a href="javascript:void(0)" class="nav-item" id="nav-tes-vouchers" onclick="cargarVouchersTesoreria(this)">
        <i class="ph ph-credit-card"></i>
        <span>Bandeja de vouchers</span>
        <span id="badge-vouchers-count" style="background-color: #ef4444; color: white; border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: bold; margin-left: auto;">1</span>
    </a>

    <a href="javascript:void(0)" class="nav-item" id="nav-tes-recibos" onclick="cargarRecibosTesoreria(this)">
        <i class="ph ph-receipt"></i>
        <span>Recibos</span>
    </a>

    <a href="javascript:void(0)" class="nav-item" id="nav-tes-matriculas" onclick="cargarMatriculasTesoreria(this)">
        <i class="ph ph-clipboard-text"></i>
        <span>Matrículas</span>
    </a>

    <a href="javascript:void(0)" class="nav-item" id="nav-tes-estudiantes" onclick="mostrarSeccionTesoreria('seccion-tes-estudiantes', this)">
        <i class="ph ph-user"></i>
        <span>Estudiantes</span>
    </a>

    <a href="javascript:void(0)" class="nav-item" id="nav-tes-buzon" onclick="mostrarSeccionTesoreria('seccion-tes-buzon', this)">
        <i class="ph ph-chat-teardrop-text"></i>
        <span>Buzón</span>
    </a>

    <a href="javascript:void(0)" class="nav-item" id="nav-tes-whatsapp" onclick="mostrarSeccionTesoreria('seccion-tes-whatsapp', this)">
        <i class="ph ph-whatsapp-logo" style="color: #22c55e;"></i>
        <span>WhatsApp</span>
    </a>

    <a href="javascript:void(0)" class="nav-item" id="nav-tes-catalogo" onclick="mostrarSeccionTesoreria('seccion-tes-catalogo', this)">
        <i class="ph ph-squares-four"></i>
        <span>Catálogo TUPA</span>
    </a>
}

<!-- Encabezado de Página (Estilo Oscuro Oficial del Sistema) -->
<div class="page-header">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1>Tesorería</h1>
            <p>Gestión de pagos, validación de comprobantes y recaudación institucional (bd.sql) · Semestre: <strong>2026-II</strong></p>
        </div>
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <span style="font-size: 0.75rem; background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.35); padding: 5px 12px; border-radius: 20px; font-weight: 700;">
                <i class="ph ph-bank"></i> Semestre 2026-II
            </span>
            <button onclick="window.print()" class="btn-icon" title="Imprimir Reporte">
                <i class="ph ph-printer"></i>
            </button>
        </div>
    </div>
    <div class="header-accent" style="background: linear-gradient(90deg, #f59e0b, #eab308);"></div>
</div>

<!-- ========================================================
     1. SECCIÓN INICIO (Estilo Oscuro Oficial)
     ======================================================== -->
<div id="seccion-tes-inicio" class="tes-section active-section">
    <!-- Tarjetas Métricas KPI -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem;">
        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background-color: rgba(245, 158, 11, 0.15); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="ph ph-credit-card"></i>
            </div>
            <div>
                <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; margin: 0 0 0.2rem 0;">Vouchers por validar</p>
                <h3 id="kpi-vouchers-num" style="font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0;">1</h3>
                <span style="font-size: 0.75rem; color: #94a3b8;">en bandeja</span>
            </div>
        </div>

        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background-color: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="ph ph-currency-circle-dollar"></i>
            </div>
            <div>
                <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; margin: 0 0 0.2rem 0;">Recaudación 2026-II</p>
                <h3 style="font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0;">S/ 230.00</h3>
                <span style="font-size: 0.75rem; color: #94a3b8;">pagos aprobados</span>
            </div>
        </div>

        <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; display: flex; align-items: center; gap: 1rem;">
            <div style="width: 48px; height: 48px; border-radius: 10px; background-color: rgba(56, 189, 248, 0.15); color: #38bdf8; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                <i class="ph ph-receipt"></i>
            </div>
            <div>
                <p style="font-size: 0.8rem; color: var(--text-secondary); text-transform: uppercase; font-weight: 600; margin: 0 0 0.2rem 0;">Recibos emitidos</p>
                <h3 style="font-size: 1.6rem; font-weight: 700; color: #fff; margin: 0;">6</h3>
                <span style="font-size: 0.75rem; color: #94a3b8;">histórico</span>
            </div>
        </div>
    </div>

    <!-- Panel 1: Vouchers esperando validación -->
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.5rem; border-top: 3px solid #f59e0b;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
            <span style="font-size: 1.15rem;">💳</span>
            <h3 style="font-size: 1.05rem; font-weight: 700; color: #fff; margin: 0;">Vouchers esperando validación</h3>
        </div>

        <div id="voucher-pendiente-item" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1rem 1.25rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 10px; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <div style="width: 42px; height: 42px; border-radius: 8px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #fbbf24; display: flex; align-items: center; justify-content: center; font-size: 1.35rem;">
                    <i class="ph ph-file-text"></i>
                </div>
                <div>
                    <h4 style="font-size: 0.95rem; font-weight: 700; color: #fff; margin: 0 0 0.25rem 0;">Huamán, Rosa Mercedes — S/ 200.00</h4>
                    <p style="font-size: 0.8rem; color: var(--text-secondary); margin: 0;">R0002 · voucher_interbank.jpg · 10/09/2026</p>
                </div>
            </div>
            <button class="btn-primary" style="background: linear-gradient(135deg, #f59e0b, #d97706); border: none; padding: 0.55rem 1.4rem; font-size: 0.85rem; font-weight: 600; border-radius: 8px; cursor: pointer; color: #fff;" onclick="abrirModalValidar()">
                Validar
            </button>
        </div>

        <div id="voucher-aprobado-msg" style="display: none; padding: 1rem; background: rgba(16, 185, 129, 0.12); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 8px; color: #34d399; font-size: 0.88rem; align-items: center; gap: 0.6rem;">
            <i class="ph ph-check-circle" style="font-size: 1.3rem;"></i>
            <span>¡Todos los vouchers pendientes han sido validados exitosamente! Bandeja al día.</span>
        </div>
    </div>

    <!-- Panel 2: Accesos rápidos -->
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem; margin-bottom: 1.5rem;">
        <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1.25rem;">
            <span style="font-size: 1.15rem; color: #fbbf24;">⚡</span>
            <h3 style="font-size: 1.05rem; font-weight: 700; color: #fff; margin: 0;">Accesos rápidos</h3>
        </div>

        <div style="display: flex; gap: 0.85rem; flex-wrap: wrap;">
            <a href="javascript:void(0)" class="module-card" style="padding: 0.85rem 1.25rem; text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 10px;" onclick="mostrarSeccionTesoreria('seccion-tes-vouchers', document.getElementById('nav-tes-vouchers'))">
                <span style="font-size: 1.15rem;">🧾</span>
                <span style="color: #fff; font-size: 0.88rem; font-weight: 600;">Bandeja de vouchers</span>
            </a>
            <a href="javascript:void(0)" class="module-card" style="padding: 0.85rem 1.25rem; text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 10px;" onclick="abrirModalNuevoRecibo()">
                <span style="font-size: 1.15rem;">💰</span>
                <span style="color: #fff; font-size: 0.88rem; font-weight: 600;">Registrar recibo</span>
            </a>
            <a href="javascript:void(0)" class="module-card" style="padding: 0.85rem 1.25rem; text-decoration: none; display: flex; align-items: center; gap: 0.75rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 10px;" onclick="mostrarSeccionTesoreria('seccion-tes-estudiantes', document.getElementById('nav-tes-estudiantes'))">
                <span style="font-size: 1.15rem;">👥</span>
                <span style="color: #fff; font-size: 0.88rem; font-weight: 600;">Estudiantes</span>
            </a>
        </div>
    </div>

    <!-- Pie Institucional -->
    <div style="margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--border-color); font-size: 0.75rem; color: var(--text-secondary);">
        IESTP "Argentina" · DRELM · Prototipo de simulación del proceso de matrícula y trámites (TUPA 2026 / RI Arts. 24–44)
    </div>
</div>

<!-- ========================================================
     2. SECCIÓN: BANDEJA DE VOUCHERS
     ======================================================== -->
<div id="seccion-tes-vouchers" class="tes-section" style="display: none;">
    <!-- Bandeja de vouchers de pago — Módulo 09 (equipo Ismael) (módulo portado, se carga con fetch) -->
</div>

