        <a href="https://wa.me/51999999999" target="_blank" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #22c55e; color: #fff; text-decoration: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600;">
            <i class="ph ph-chat-circle-dots"></i> Iniciar Chat de Atención
        </a>
    </div>
</div>

