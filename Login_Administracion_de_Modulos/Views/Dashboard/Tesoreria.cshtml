                        <td style="padding: 0.85rem 0.5rem; color: #fff; font-weight: 600;">Juan Diego Pérez</td>
                        <td style="padding: 0.85rem 0.5rem; color: var(--text-secondary);">jperez@instituto.edu.pe</td>
                        <td style="padding: 0.85rem 0.5rem;"><span style="color: #34d399; font-weight: 600;">Al día</span></td>
                        <td style="padding: 0.85rem 0.5rem; text-align: center;">
