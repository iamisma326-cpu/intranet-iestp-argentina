                    </tr>
                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                        <td style="padding: 0.85rem 0.5rem; color: var(--text-secondary);">DNI 44556677</td>
                        <td style="padding: 0.85rem 0.5rem; color: #fff; font-weight: 600;">Rosa Mercedes Huamán García</td>
                        <td style="padding: 0.85rem 0.5rem; color: var(--text-secondary);">rmgarcia@instituto.edu.pe</td>
                        <td style="padding: 0.85rem 0.5rem;"><span style="color: #fbbf24; font-weight: 600;">Voucher por validar</span></td>
                        <td style="padding: 0.85rem 0.5rem; text-align: center;">
                            <button style="background: #f59e0b; color: #000; border: none; border-radius: 6px; padding: 4px 10px; font-size: 0.78rem; font-weight: 600; cursor: pointer;" onclick="abrirModalValidar()">Validar Pago</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================
