    <!-- Gestión de matrículas — Módulo 01 (equipo Ismael) (módulo portado, se carga con fetch) -->
</div>

<!-- ========================================================
     5. SECCIÓN: ESTUDIANTES
     ======================================================== -->
<div id="seccion-tes-estudiantes" class="tes-section" style="display: none;">
    <div style="margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.4rem; font-weight: 700; color: #fff; margin: 0 0 0.25rem 0;">Padrón de Estudiantes (`personas`)</h2>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0;">Registro institucional de alumnos para cobros, saldos y trámites de tesorería</p>
