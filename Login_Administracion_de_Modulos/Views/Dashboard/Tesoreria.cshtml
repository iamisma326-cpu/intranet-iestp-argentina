@section Scripts {
    <script>
        // --- Carga de módulos portados (M09: vouchers y recibos; M01: matrículas) ---
        function cargarSeccionModuloTes(idSeccion, url, el) {
            mostrarSeccionTesoreria(idSeccion, el);
            const container = document.getElementById(idSeccion);
            if (container.dataset.loaded) return;
            container.innerHTML = `
                <div style="padding: 3rem; text-align: center; color: var(--text-secondary);">
                    <i class="ph ph-spinner ph-spin" style="font-size: 2.5rem; color: #10b981; margin-bottom: 1rem; display: block;"></i>
                    <p>Cargando módulo...</p>
                </div>`;
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(res => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.text(); })
                .then(html => {
                    container.innerHTML = html;
                    container.dataset.loaded = "true";
                    const scripts = container.querySelectorAll('script');
                    scripts.forEach(oldScript => {
                        const newScript = document.createElement('script');
                        Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                })
                .catch(err => {
                    container.innerHTML = `<div style="padding: 2rem; color: #ef4444;">No se pudo cargar: ${err.message}</div>`;
                });
        }
        function cargarVouchersTesoreria(el)  { cargarSeccionModuloTes('seccion-tes-vouchers', '/Modulo09/Pagos?partial=true', el); }
        function cargarRecibosTesoreria(el)   { cargarSeccionModuloTes('seccion-tes-recibos', '/Modulo09/Pagos/Bandeja?partial=true', el); }
        function cargarMatriculasTesoreria(el){ cargarSeccionModuloTes('seccion-tes-matriculas', '/Modulo01/Matriculas?partial=true', el); }

        function mostrarSeccionTesoreria(seccionId, navElement) {
            // 1. Quitar clase active a todos los botones del panel lateral
            const items = document.querySelectorAll('.nav-item');
            items.forEach(el => el.classList.remove('active'));

            // 2. Activar el elemento seleccionado
            if (navElement) {
                navElement.classList.add('active');
            }

            // 3. Ocultar todas las vistas
            const tabs = document.querySelectorAll('.tes-section');
            tabs.forEach(t => t.style.display = 'none');

            // 4. Mostrar la vista elegida
            const target = document.getElementById(seccionId);
            if (target) {
                target.style.display = 'block';
            }
        }

        function abrirModalValidar() {
            const modal = document.getElementById('modal-validar-voucher');
            if (modal) modal.style.display = 'flex';
        }

        function cerrarModalValidar() {
            const modal = document.getElementById('modal-validar-voucher');
            if (modal) modal.style.display = 'none';
        }

        function aprobarVoucher() {
            cerrarModalValidar();
            
            // Ocultar voucher en espera y mostrar mensaje de éxito
            const item = document.getElementById('voucher-pendiente-item');
            const msg = document.getElementById('voucher-aprobado-msg');
            const kpiNum = document.getElementById('kpi-vouchers-num');
            const badgeCount = document.getElementById('badge-vouchers-count');
            const estadoTag = document.getElementById('tag-vch-estado');

            if (item) item.style.display = 'none';
            if (msg) msg.style.display = 'flex';
            if (kpiNum) kpiNum.innerText = '0';
            if (badgeCount) badgeCount.style.display = 'none';
            if (estadoTag) {
                estadoTag.style.background = 'rgba(16, 185, 129, 0.2)';
                estadoTag.style.color = '#34d399';
                estadoTag.innerText = 'Aprobado';
            }

            alert('¡Voucher validado con éxito!\nSe ha generado el Recibo Oficial R-0002-2026 para Huamán, Rosa Mercedes por S/ 200.00.');
        }

        function abrirModalNuevoRecibo() {
            alert('Apertura de formulario de emisión rápida de recibo para trámites TUPA.');
        }
    </script>
}
