<!-- ========================================================
     MODAL INTERACTIVO DE VALIDACIÓN DE VOUCHER (ESTILO OSCURO)
     ======================================================== -->
<div id="modal-validar-voucher" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 1rem;">
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; max-width: 520px; width: 100%; padding: 1.75rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
