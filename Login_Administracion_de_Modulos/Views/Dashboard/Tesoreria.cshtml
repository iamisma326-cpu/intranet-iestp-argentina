     ======================================================== -->
<div id="seccion-tes-buzon" class="tes-section" style="display: none;">
    <div style="margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.4rem; font-weight: 700; color: #fff; margin: 0 0 0.25rem 0;">Buzón de Consultas y Solicitudes</h2>
        <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0;">Comunicaciones de estudiantes sobre pagos y emisión de constancias</p>
    </div>

    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 1.5rem;">
        <div style="padding: 1.25rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color); border-radius: 10px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                <strong style="color: #fff;">Huamán, Rosa Mercedes</strong>
                <span style="font-size: 0.75rem; color: var(--text-secondary);">Hace 3 horas</span>
            </div>
            <p style="font-size: 0.85rem; color: #cbd5e1; margin: 0 0 0.75rem 0;">Buenas tardes tesorería, adjunté mi voucher de depósito de Interbank para la matrícula del ciclo 2026-II. Por favor verificar.</p>
            <button style="background: #f59e0b; color: #000; border: none; padding: 0.4rem 0.9rem; font-size: 0.78rem; font-weight: 600; border-radius: 6px; cursor: pointer;" onclick="abrirModalValidar()">Responder y Validar</button>
        </div>
    </div>
</div>

<!-- ========================================================
     7. SECCIÓN: WHATSAPP
     ======================================================== -->
<div id="seccion-tes-whatsapp" class="tes-section" style="display: none;">
