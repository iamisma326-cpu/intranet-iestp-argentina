@section Scripts {
    <script>
        function mostrarSeccionConta(seccionId, navElement) {
            // 1. Quitar estado active de todos los enlaces de navegación de contabilidad
            const links = document.querySelectorAll('.nav-item-conta');
            links.forEach(l => l.classList.remove('active'));

            // 2. Activar el enlace seleccionado
            if (navElement) {
                navElement.classList.add('active');
            }

            // 3. Ocultar todas las secciones
            const secciones = document.querySelectorAll('.conta-section');
            secciones.forEach(s => s.style.display = 'none');

            // 4. Mostrar la sección seleccionada si existe o la sección genérica informativa
            const target = document.getElementById(seccionId);
            if (target) {
                target.style.display = 'block';
            } else {
                const generico = document.getElementById('seccion-conta-generico');
                if (generico) {
                    generico.style.display = 'block';
                    const navText = navElement ? navElement.querySelector('.nav-text')?.innerText : 'Módulo';
                    document.getElementById('conta-generico-titulo').innerText = navText;
                    document.getElementById('conta-generico-desc').innerText = 'Operatividad del submódulo ' + navText + ' para el área de Contabilidad.';
                }
            }
        }

        function toggleDropdownConta(groupId) {
            const group = document.getElementById(groupId);
            if (group) {
                group.classList.toggle('open');
            }
        }
    </script>
}
