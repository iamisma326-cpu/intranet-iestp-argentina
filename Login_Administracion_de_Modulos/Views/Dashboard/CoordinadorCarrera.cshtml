                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
            <a href="javascript:void(0)" class="nav-item-computacion" id="nav-comp-dash" onclick="mostrarSeccionComp('seccion-comp-dash', this)">
                <i class="ph ph-squares-four nav-icon"></i>
                <span class="nav-text">Dashboard</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
        </div>
    </div>

    <!-- SECCIÓN INVENTARIO (Desplegable) -->
    <div class="sidebar-dropdown sidebar-dropdown-computacion open" id="group-comp-inventario">
