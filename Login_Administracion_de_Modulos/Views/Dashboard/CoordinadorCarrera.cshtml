@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Coordinación de Carrera";
    ViewData["Role"] = "Coordinador de Carrera";
}

@section SidebarNav {
    <!-- Encabezado de Inventario & Almacenes -->
    <div class="sidebar-brand-box" style="border-color: rgba(56, 189, 248, 0.25);">
        <div class="brand-icon-wrap" style="background: rgba(2, 132, 199, 0.15); border-color: rgba(56, 189, 248, 0.35); color: #38bdf8;">
            <i class="ph ph-buildings"></i>
        </div>
        <div class="brand-details">
            <h5>IESTP "Argentina"</h5>
            <p>Inventario & Almacenes</p>
        </div>
    </div>

    <!-- SECCIÓN GENERAL (Desplegable) -->
    <div class="sidebar-dropdown sidebar-dropdown-computacion open" id="group-comp-general">
        <div class="sidebar-dropdown-header" onclick="toggleDropdownComp('group-comp-general')">
            <span class="dropdown-title">General</span>
            <i class="ph ph-caret-down dropdown-caret"></i>
        </div>
        <div class="sidebar-dropdown-body">
            <a href="javascript:void(0)" class="nav-item-computacion" id="nav-comp-inicio" onclick="mostrarSeccionComp('seccion-comp-inicio', this)">
