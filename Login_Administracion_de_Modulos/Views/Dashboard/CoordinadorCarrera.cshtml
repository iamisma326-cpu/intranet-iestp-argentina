<div id="seccion-comp-almacenes" class="comp-section" style="display: none;">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 2rem;">
        <h2 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;"><i class="ph ph-package" style="color: #38bdf8;"></i> Almacén de Cómputo (`almacen`)</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Custodia técnica de partes, repuestos, discos y periféricos para el área de Computación.</p>
        <div style="border: 1px solid var(--border-color); padding: 1.25rem; border-radius: 10px; max-width: 450px;">
            <h4 style="color: #fff; margin-bottom: 0.25rem;">Subalmacén de Partes TI</h4>
            <p style="font-size: 0.8rem; color: var(--text-secondary);">Ubicación: Pabellón A - Laboratorio 1 Anexo</p>
            <p style="font-size: 0.8rem; color: var(--text-secondary);">Responsable: Coordinador de Carrera</p>
        </div>
    </div>
</div>

<div id="seccion-comp-ambientes" class="comp-section" style="display: none;">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 2rem;">
        <h2 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;"><i class="ph ph-door" style="color: #38bdf8;"></i> Ambientes de Computación (`ambiente`)</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Laboratorios y aulas asignadas exclusivamente a la especialidad de Computación e Informática:</p>
        <ul style="color: var(--text-secondary); line-height: 1.8; padding-left: 1.25rem;">
            <li><strong style="color: #fff;">Laboratorio de Cómputo 01</strong> - 35 Estaciones de Trabajo</li>
            <li><strong style="color: #fff;">Laboratorio de Cómputo 02</strong> - 30 Estaciones de Redes</li>
            <li><strong style="color: #fff;">Taller de Ensamblaje y Conectividad</strong> - 15 Bancos de Prueba</li>
            <li><strong style="color: #fff;">Centro de Datos y Servidores</strong> - Rack Principal</li>
        </ul>
    </div>
</div>

<div id="seccion-comp-especialidades" class="comp-section" style="display: none;">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 2rem;">
        <h2 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;"><i class="ph ph-gear" style="color: #38bdf8;"></i> Especialidad Asignada (`especialidad`)</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Área técnica a cargo: <strong>Computación e Informática</strong> (Estado: Activo en bd.sql).</p>
    </div>
</div>

<div id="seccion-comp-generico" class="comp-section" style="display: none;">
    <div class="construction-card">
        <i class="ph ph-desktop construction-icon" style="color: #38bdf8;"></i>
        <h2 id="comp-generico-titulo" style="color: #fff;">Módulo de Taller Computación</h2>
        <p id="comp-generico-desc">Gestión y control de equipamiento tecnológico del área de Computación conforme a `bd.sql`.</p>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarSeccionComp(seccionId, navElement) {
            // 1. Quitar estado active de todos los enlaces de navegación de computación
            const links = document.querySelectorAll('.nav-item-computacion');
            links.forEach(l => l.classList.remove('active'));

            // 2. Activar el enlace seleccionado
            if (navElement) {
                navElement.classList.add('active');
            }

            // 3. Ocultar todas las secciones
            const secciones = document.querySelectorAll('.comp-section');
            secciones.forEach(s => s.style.display = 'none');

            // 4. Mostrar la sección seleccionada si existe o la sección genérica informativa
            const target = document.getElementById(seccionId);
            if (target) {
                target.style.display = 'block';
            } else {
                const generico = document.getElementById('seccion-comp-generico');
                if (generico) {
                    generico.style.display = 'block';
                    const navText = navElement ? navElement.querySelector('.nav-text')?.innerText : 'Módulo';
                    document.getElementById('comp-generico-titulo').innerText = navText;
                    document.getElementById('comp-generico-desc').innerText = 'Operatividad del submódulo ' + navText + ' para el área de Computación e Informática.';
                }
            }
        }

        function toggleDropdownComp(groupId) {
            const group = document.getElementById(groupId);
            if (group) {
                group.classList.toggle('open');
            }
        }
    </script>
}
