                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
            <a href="javascript:void(0)" class="nav-item-computacion" id="nav-comp-especialidades" onclick="mostrarSeccionComp('seccion-comp-especialidades', this)">
                <i class="ph ph-gear nav-icon"></i>
                <span class="nav-text">Especialidades</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
        </div>
    </div>

    <!-- SECCIÓN OPERACIONES (Desplegable) -->
