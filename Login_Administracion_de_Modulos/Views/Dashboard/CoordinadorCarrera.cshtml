                <span class="nav-text">Exportar Excel</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Inferior de Área Asignada (Visible en el panel) -->
    <div class="area-footer-box">
        <i class="ph ph-laptop area-icon"></i>
        <div class="area-info">
            <h5>Área: Computación</h5>
            <p>Usuario: Jefe Computación</p>
        </div>
    </div>
