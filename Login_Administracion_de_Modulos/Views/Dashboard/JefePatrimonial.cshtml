            <div style="width: 46px; height: 46px; border-radius: 10px; background-color: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.4rem;">
                <i class="ph ph-check-circle"></i>
            </div>
            <div>
