<!-- 2. SECCIÓN INICIO / DASHBOARD GENERAL -->
<div id="seccion-jefe-inicio" class="jefe-section" style="display: none;">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 2rem;">
        <h2 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;"><i class="ph ph-house" style="color: #f43f5e;"></i> Panel de Inicio - Jefatura de Almacenes</h2>
        <p style="color: var(--text-secondary); margin-bottom: 1.5rem;">Vista general de operaciones de recepción, despacho y control de bienes patrimoniales.</p>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
            <div style="border: 1px solid var(--border-color); border-radius: 10px; padding: 1.25rem; background: rgba(255, 255, 255, 0.02);">
                <h4 style="color: #f43f5e; margin-bottom: 0.5rem;"><i class="ph ph-arrows-clockwise"></i> Operaciones Recientes</h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary);">3 transferencias de ambiente aprobadas hoy.</p>
                <p style="font-size: 0.85rem; color: var(--text-secondary);">12 bienes nuevos ingresados a Almacén Central.</p>
            </div>
            <div style="border: 1px solid var(--border-color); border-radius: 10px; padding: 1.25rem; background: rgba(255, 255, 255, 0.02);">
                <h4 style="color: #10b981; margin-bottom: 0.5rem;"><i class="ph ph-calendar-check"></i> Inventario Anual Vigente</h4>
                <p style="font-size: 0.85rem; color: var(--text-secondary);">Periodo 2026 en ejecución al 68% de avance.</p>
            </div>
        </div>
    </div>
</div>

<div id="seccion-jefe-dash" class="jefe-section" style="display: none;">
