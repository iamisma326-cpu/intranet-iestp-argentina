<!-- Encabezado Institucional -->
<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="width: 52px; height: 52px; background: rgba(244, 63, 94, 0.1); border: 1.5px solid rgba(244, 63, 94, 0.35); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; color: #f43f5e;">
            <i class="ph ph-buildings"></i>
        </div>
        <div>
            <h1 style="font-size: 1.45rem; font-weight: 800; color: #ffffff; margin: 0; line-height: 1.2;">IESTP "Argentina"</h1>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin: 0.2rem 0 0 0;">Sistema de Gestión de Inventario para Almacenes</p>
        </div>
    </div>

    <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span style="font-size: 0.75rem; background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3); padding: 5px 12px; border-radius: 20px; font-weight: 700;">
            <i class="ph ph-shield-check"></i> Acceso Total
        </span>
        <button onclick="window.print()" class="btn-icon" title="Imprimir Reporte">
            <i class="ph ph-printer"></i>
        </button>
    </div>
</div>

<!-- Banner Destacado del Rol Jefe Patrimonial -->
