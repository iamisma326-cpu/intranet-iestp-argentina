@section Scripts {
    <script>
        function mostrarSeccionJefe(seccionId, navElement) {
            // 1. Quitar estado active de todos los enlaces de navegación del jefe
            const links = document.querySelectorAll('.nav-item-jefe');
            links.forEach(l => l.classList.remove('active'));

            // 2. Activar el enlace seleccionado
            if (navElement) {
                navElement.classList.add('active');
            }

            // 3. Ocultar todas las secciones
            const secciones = document.querySelectorAll('.jefe-section');
            secciones.forEach(s => s.style.display = 'none');

            // 4. Mostrar la sección seleccionada si existe o la sección genérica informativa
            const target = document.getElementById(seccionId);
            if (target) {
                target.style.display = 'block';
            } else {
                const generico = document.getElementById('seccion-jefe-generico');
                if (generico) {
                    generico.style.display = 'block';
                    const navText = navElement ? navElement.querySelector('.nav-text')?.innerText : 'Módulo';
                    document.getElementById('generico-titulo').innerText = navText;
                    document.getElementById('generico-desc').innerText = 'Vista operativa del submódulo ' + navText + ' conforme a la arquitectura de bd.sql.';
                }
            }
        }

        function toggleDropdownJefe(groupId) {
            const group = document.getElementById(groupId);
            if (group) {
                group.classList.toggle('open');
            }
        }
    </script>
}
