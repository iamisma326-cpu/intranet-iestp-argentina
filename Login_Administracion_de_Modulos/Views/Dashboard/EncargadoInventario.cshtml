        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
            <div style="border: 1px solid var(--border-color); border-radius: 10px; padding: 1.25rem; background: rgba(124, 58, 237, 0.04);">
