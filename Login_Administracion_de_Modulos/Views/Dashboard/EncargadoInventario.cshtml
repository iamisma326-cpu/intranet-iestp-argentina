                <i class="ph ph-file-xls nav-icon" style="color: #4ade80;"></i>
                <span class="nav-text">Exportar Excel</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta Inferior de Área Asignada (Visible en el panel) -->
    <div class="area-footer-box" style="background: #faf5ff; border: 1px solid #f3e8ff;">
        <i class="ph ph-package area-icon" style="color: #7c3aed;"></i>
        <div class="area-info">
