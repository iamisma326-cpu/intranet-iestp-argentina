@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Encargado de Inventario - Operaciones Patrimoniales";
    ViewData["Role"] = "Encargado de Inventario";
}

@section SidebarNav {
    <!-- Encabezado de Inventario & Almacenes -->
    <div class="sidebar-brand-box" style="border-color: rgba(168, 85, 247, 0.25);">
        <div class="brand-icon-wrap" style="background: rgba(124, 58, 237, 0.15); border-color: rgba(168, 85, 247, 0.35); color: #a855f7;">
            <i class="ph ph-buildings"></i>
        </div>
        <div class="brand-details">
            <h5>IESTP "Argentina"</h5>
            <p>Inventario & Almacenes</p>
        </div>
    </div>

    <!-- SECCIÓN GENERAL (Desplegable) -->
    <div class="sidebar-dropdown sidebar-dropdown-inventario open" id="group-inv-general">
        <div class="sidebar-dropdown-header" onclick="toggleDropdownInventario('group-inv-general')">
            <span class="dropdown-title">General</span>
            <i class="ph ph-caret-down dropdown-caret"></i>
        </div>
        <div class="sidebar-dropdown-body">
            <a href="javascript:void(0)" class="nav-item-inventario" id="nav-inv-inicio" onclick="mostrarSeccionInventario('seccion-inv-inicio', this)">
                <i class="ph ph-house nav-icon"></i>
                <span class="nav-text">Inicio</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
            <a href="javascript:void(0)" class="nav-item-inventario" id="nav-inv-dash" onclick="mostrarSeccionInventario('seccion-inv-dash', this)">
                <i class="ph ph-squares-four nav-icon"></i>
                <span class="nav-text">Dashboard</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
        </div>
    </div>

    <!-- SECCIÓN INVENTARIO (Desplegable) -->
    <div class="sidebar-dropdown sidebar-dropdown-inventario open" id="group-inv-inventario">
        <div class="sidebar-dropdown-header" onclick="toggleDropdownInventario('group-inv-inventario')">
            <span class="dropdown-title">Inventario</span>
            <i class="ph ph-caret-down dropdown-caret"></i>
        </div>
        <div class="sidebar-dropdown-body">
            <a href="javascript:void(0)" class="nav-item-inventario active" id="nav-inv-bienes" onclick="mostrarSeccionInventario('seccion-inv-bienes', this)">
                <i class="ph ph-desktop nav-icon"></i>
                <span class="nav-text">Bienes</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
            <a href="javascript:void(0)" class="nav-item-inventario" id="nav-inv-almacenes" onclick="mostrarSeccionInventario('seccion-inv-almacenes', this)">
