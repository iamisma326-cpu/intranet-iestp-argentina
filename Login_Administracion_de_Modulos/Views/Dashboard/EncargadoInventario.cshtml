<div id="seccion-inv-recepciones" class="inv-section" style="display: none;">
    <div style="background-color: var(--bg-card); border: 1px solid var(--border-color); border-radius: 14px; padding: 2rem;">
        <h2 style="font-size: 1.4rem; color: #fff; margin-bottom: 0.5rem;"><i class="ph ph-shopping-cart" style="color: #a855f7;"></i> Recepciones y Entradas de Bienes</h2>
