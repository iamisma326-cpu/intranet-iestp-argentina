                <span class="nav-text">Especialidades</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
        </div>
    </div>

    <!-- SECCIÓN OPERACIONES (Desplegable) -->
    <div class="sidebar-dropdown sidebar-dropdown-inventario open" id="group-inv-operaciones">
        <div class="sidebar-dropdown-header" onclick="toggleDropdownInventario('group-inv-operaciones')">
            <span class="dropdown-title">Operaciones</span>
            <i class="ph ph-caret-down dropdown-caret"></i>
        </div>
        <div class="sidebar-dropdown-body">
