</div>

<div id="seccion-inv-generico" class="inv-section" style="display: none;">
    <div class="construction-card">
        <i class="ph ph-package construction-icon" style="color: #a855f7;"></i>
        <h2 id="inv-generico-titulo" style="color: #fff;">Operaciones de Inventario</h2>
        <p id="inv-generico-desc">Gestión y control patrimonial operativo conforme a `bd.sql`.</p>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarSeccionInventario(seccionId, navElement) {
            // 1. Quitar estado active de todos los enlaces de navegación de inventario
            const links = document.querySelectorAll('.nav-item-inventario');
            links.forEach(l => l.classList.remove('active'));

            // 2. Activar el enlace seleccionado
            if (navElement) {
                navElement.classList.add('active');
            }

            // 3. Ocultar todas las secciones
            const secciones = document.querySelectorAll('.inv-section');
            secciones.forEach(s => s.style.display = 'none');

            // 4. Mostrar la sección seleccionada si existe o la sección genérica informativa
            const target = document.getElementById(seccionId);
            if (target) {
                target.style.display = 'block';
            } else {
                const generico = document.getElementById('seccion-inv-generico');
                if (generico) {
                    generico.style.display = 'block';
                    const navText = navElement ? navElement.querySelector('.nav-text')?.innerText : 'Módulo';
                    document.getElementById('inv-generico-titulo').innerText = navText;
                    document.getElementById('inv-generico-desc').innerText = 'Operatividad del submódulo ' + navText + ' para la gestión general de inventario.';
                }
            }
        }

        function toggleDropdownInventario(groupId) {
            const group = document.getElementById(groupId);
            if (group) {
                group.classList.toggle('open');
            }
        }
    </script>
}
