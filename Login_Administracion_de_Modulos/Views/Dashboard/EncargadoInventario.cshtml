                <span class="nav-text">Almacenes</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
            <a href="javascript:void(0)" class="nav-item-inventario" id="nav-inv-ambientes" onclick="mostrarSeccionInventario('seccion-inv-ambientes', this)">
                <i class="ph ph-door nav-icon"></i>
                <span class="nav-text">Ambientes</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
            <a href="javascript:void(0)" class="nav-item-inventario" id="nav-inv-especialidades" onclick="mostrarSeccionInventario('seccion-inv-especialidades', this)">
