        <div class="sidebar-dropdown-header" onclick="toggleDropdownInventario('group-inv-reportes')">
            <span class="dropdown-title">Reportes</span>
            <i class="ph ph-caret-down dropdown-caret"></i>
        </div>
        <div class="sidebar-dropdown-body">
            <a href="javascript:void(0)" class="nav-item-inventario" id="nav-inv-reportes" onclick="mostrarSeccionInventario('seccion-inv-reportes', this)">
                <i class="ph ph-file-text nav-icon"></i>
                <span class="nav-text">Reportes</span>
                <i class="ph ph-caret-right nav-arrow"></i>
            </a>
