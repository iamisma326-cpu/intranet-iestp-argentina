@model Login_Administracion_de_Modulos.Areas.Modulo01.Controllers.ModeloPanelMatriculasVista
@{
    ViewData["Title"] = "Matrículas 2026-II";
    var rolActivo = User.FindFirst("ActiveRole")?.Value ?? "";
}

<div class="space-y-6">
    <!-- Header Zen -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-sky-50 dark:bg-sky-950/50 text-sky-600 dark:text-sky-400 flex items-center justify-center text-xl shrink-0">📝</div>
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <span class="text-[10px] font-mono font-bold bg-sky-100 dark:bg-sky-950 text-sky-800 dark:text-sky-300 px-2 py-0.5 rounded">01</span>
                    <span class="text-xs font-bold text-sky-700 dark:text-sky-300 bg-sky-50 dark:bg-sky-900/40 px-2 py-0.5 rounded-md border border-sky-200 dark:border-sky-800">Puesto de trabajo</span>
                @if (string.Equals(rolActivo, "Tesoreria", System.StringComparison.OrdinalIgnoreCase) && !string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase))
                {
                    <span class="text-xs font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-900/40 px-2 py-0.5 rounded-md border border-emerald-200 dark:border-emerald-800">Tu bandeja: validación de vouchers</span>
                }
                else if (string.Equals(rolActivo, "Secretaria", System.StringComparison.OrdinalIgnoreCase) && !string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase))
                {
                    <span class="text-xs font-bold text-indigo-700 dark:text-indigo-300 bg-indigo-50 dark:bg-indigo-900/40 px-2 py-0.5 rounded-md border border-indigo-200 dark:border-indigo-800">Tu bandeja: validación de fotos + conformidad</span>
                }
                </div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">Panel de Trabajo</h1>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Las 4 zonas del proceso: listas, en espera, por liberar y general.</p>
            </div>
        </div>
        <a class="btn btn-outline btn-sm rounded-xl text-xs" asp-action="Vacantes">📊 Vacantes</a>
    </div>

    <!-- Métricas -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Matriculados</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@Model.Resumen.Matriculados</div>
            <p class="text-[10px] text-slate-400 mt-0.5">con conformidad</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Listas para registrar</span>
            <div class="text-xl font-bold text-sky-600 dark:text-sky-400 mt-1">@Model.Resumen.ListasParaRegistrar</div>
            <p class="text-[10px] text-slate-400 mt-0.5">doble validación completa</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">En espera</span>
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">@Model.Resumen.EnEspera</div>
            <p class="text-[10px] text-slate-400 mt-0.5">falta voucher o foto</p>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Reservadas</span>
            <div class="text-xl font-bold text-slate-700 dark:text-slate-300 mt-1">@Model.Resumen.Reservadas</div>
            <p class="text-[10px] text-slate-400 mt-0.5">Art. 24 RI</p>
        </div>
    </div>

    <!-- Zona B: En espera de validación -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 p-5 shadow-sm">
        <div class="flex items-center gap-2 mb-1">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">⏳ En espera de validación</h2>
            <span class="badge badge-warning badge-xs font-semibold text-white">@Model.EnEspera.Count()</span>
            @if (string.Equals(rolActivo, "Tesoreria", System.StringComparison.OrdinalIgnoreCase) && !string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge badge-success badge-xs font-semibold text-white">Tu bandeja de vouchers 💳</span>
            }
            else if (string.Equals(rolActivo, "Secretaria", System.StringComparison.OrdinalIgnoreCase) && !string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase))
            {
                <span class="badge badge-success badge-xs font-semibold text-white">Tu bandeja de fotos 📷</span>
            }
        </div>
        <p class="text-[11px] text-slate-400 mb-3">No se puede registrar la conformidad sin la doble validación (Pago + Foto). Tesorería valida el voucher; Secretaría la foto.</p>
        @if (!Model.EnEspera.Any())
        {
            <p class="text-xs text-slate-400 italic">Nada pendiente de validación.</p>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var m in Model.EnEspera)
                {
                    <div class="flex items-center gap-3 bg-slate-50 dark:bg-slate-900/50 rounded-xl p-3">
                        <span class="text-lg">@(m.VoucherOk ? "📷" : "💳")</span>
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-bold text-slate-900 dark:text-slate-100 font-mono">@m.Codigo — @m.Estudiante</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                @m.CarreraCodigo · @m.Ciclo · Turno @m.Turno ·
                                Pago @(m.VoucherOk ? Html.Raw("<span class=\"badge badge-success badge-xs font-semibold text-white\">Validado</span>") : Html.Raw("<span class=\"badge badge-warning badge-xs font-semibold text-white\">Pendiente</span>"))
                                Foto @(m.FotoOk ? Html.Raw("<span class=\"badge badge-success badge-xs font-semibold text-white\">Validada</span>") : Html.Raw("<span class=\"badge badge-ghost badge-xs\">Sin foto</span>"))
                            </div>
                        </div>
                        <div class="flex gap-1">
                            @if (m.TramiteReservaId is int tid)
                            {
                                <a href="/Modulo09/Tramites/Detalle/@tid" target="_blank"
                                   class="btn btn-ghost btn-xs rounded-lg font-bold text-slate-500" title="Ver el trámite de reserva con los archivos adjuntos (voucher, foto, documentos)">📁 Ver expediente</a>
                            }
                            @if (!m.VoucherOk && (string.Equals(rolActivo, "Tesoreria", System.StringComparison.OrdinalIgnoreCase) || string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase)))
                            {
                                <form method="post" asp-action="ValidarVoucher" asp-route-id="@m.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline btn-xs rounded-xl">Validar voucher</button>
                                </form>
                            }
                            @if (!m.FotoOk && (string.Equals(rolActivo, "Secretaria", System.StringComparison.OrdinalIgnoreCase) || string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase)))
                            {
                                <form method="post" asp-action="ValidarFoto" asp-route-id="@m.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline btn-xs rounded-xl">Validar foto</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Zona A: Listas para registrar (verde) -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-emerald-200 dark:border-emerald-900/60 border-l-4 border-l-emerald-500 p-5 shadow-sm">
        <div class="flex items-center gap-2 mb-1">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">✅ Listas para matricular</h2>
            <span class="badge badge-success badge-xs font-semibold text-white">@Model.ListasParaRegistrar.Count()</span>
        </div>
        <p class="text-[11px] text-slate-400 mb-3">Voucher validado por Tesorería y foto validada por Secretaría. Registrar consume 1 vacante. La conformidad la da Secretaría Académica.</p>
        @if (!Model.ListasParaRegistrar.Any())
        {
            <div class="text-xs text-slate-400 italic space-y-2">
                <p>Sin matrículas listas por ahora.</p>
                <p class="not-italic">
                    ℹ️ Esta bandeja corresponde al flujo de validación interna (voucher + foto subidos aquí).
                    En el flujo real de <strong>Reserva de Matrícula (TM05/CT13)</strong>, el alumno paga y sube su voucher
                    en el módulo 09, Tesorería lo valida allí, y el cierre de la matrícula se hace desde
                    <a href="/Modulo01/Matriculatura" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-primary/30 bg-primary/5 text-primary hover:bg-primary/10 transition font-bold">🗂️ Abrir Matriculatura <span aria-hidden="true">↗</span></a> buscando al alumno por DNI.
                </p>
            </div>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var m in Model.ListasParaRegistrar)
                {
                    <div class="flex items-center gap-3 bg-emerald-50 dark:bg-emerald-950/30 rounded-xl p-3">
                        <span class="text-lg">🎓</span>
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-bold text-slate-900 dark:text-slate-100 font-mono">@m.Codigo — @m.Estudiante</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                @m.CarreraCodigo · @m.Ciclo · Turno @m.Turno ·
                                Pago <span class="badge badge-success badge-xs font-semibold text-white">Validado</span>
                                Foto <span class="badge badge-success badge-xs font-semibold text-white">Validada</span>
                            </div>
                        </div>
                        @if (string.Equals(rolActivo, "Secretaria", System.StringComparison.OrdinalIgnoreCase) || string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase))
                        {
                            <form method="post" asp-action="Registrar" asp-route-id="@m.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success btn-xs rounded-xl font-bold">Registrar matrícula</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-[10px] text-slate-400 italic">Solo Secretaría puede registrar la conformidad.</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Zona C: Vacantes por liberar -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-rose-200 dark:border-rose-900/60 border-l-4 border-l-rose-500 p-5 shadow-sm">
        <div class="flex items-center gap-2 mb-1">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">⏰ Vacantes por liberar (Art. 24 RI)</h2>
            <span class="badge badge-error badge-xs font-semibold text-white">@Model.PorLiberar.Count()</span>
        </div>
        <p class="text-[11px] text-slate-400 mb-3">Matrículas "En trámite" con más de 20 días sin completar la doble validación.</p>
        @if (!Model.PorLiberar.Any())
        {
            <p class="text-xs text-slate-400 italic">Sin matrículas trancadas.</p>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var m in Model.PorLiberar)
                {
                    <div class="flex items-center gap-3 bg-rose-50 dark:bg-rose-950/30 rounded-xl p-3">
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-bold text-slate-900 dark:text-slate-100 font-mono">@m.Codigo — @m.Estudiante</div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                Iniciada el @m.CreadoEn.ToString("dd/MM/yyyy") · <span class="font-bold text-rose-600 dark:text-rose-400">@m.DiasTranscurridos días</span> · vacante @m.CarreraCodigo-@m.Turno en reserva
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Tabla general del semestre -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex flex-wrap justify-between items-center gap-2">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider">📋 Todas las matrículas del semestre</h2>
            <form method="get" class="flex gap-2">
                <select name="estado" class="select select-xs select-bordered rounded-xl dark:bg-slate-800">
                    <option value="">Todos los estados</option>
                    @foreach (var e in new[] { "En trámite", "Matriculado", "Reservada", "Anulada" })
                    {
                        <option value="@e" selected="@(Model.FiltroEstado == e)">@e</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline btn-xs rounded-xl">Filtrar</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="table table-zebra w-full text-xs">
                <thead>
                    <tr class="text-slate-400 dark:text-slate-500 uppercase text-[10px]">
                        <th>Código</th>
                        <th>Estudiante</th>
                        <th>Carrera</th>
                        <th>Ciclo</th>
                        <th>Turno</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Registro</th>
                    </tr>
                </thead>
                <tbody class="text-slate-700 dark:text-slate-300">
                    @foreach (var m in Model.Todas)
                    {
                        <tr>
                            <td class="font-mono font-bold text-sky-600 dark:text-sky-400">@m.Codigo</td>
                            <td class="font-medium text-slate-900 dark:text-slate-100">@m.Estudiante</td>
                            <td>@m.CarreraCodigo</td>
                            <td>@m.Ciclo</td>
                            <td>@m.Turno</td>
                            <td>@m.TipoMatricula</td>
                            <td>
                                @if (m.Estado == "Matriculado")
                                {
                                    <span class="badge badge-success badge-xs font-semibold text-white">Matriculado</span>
                                }
                                else if (m.Estado == "En trámite")
                                {
                                    <span class="badge badge-warning badge-xs font-semibold text-white">En trámite</span>
                                }
                                else if (m.Estado == "Reservada")
                                {
                                    <span class="badge badge-info badge-xs font-semibold text-white">Reservada</span>
                                }
                                else
                                {
                                    <span class="badge badge-ghost badge-xs">Anulada</span>
                                }
                            </td>
                            <td class="text-slate-400 font-mono">@(m.FechaMatricula?.ToString("dd/MM/yyyy") ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (false) { }


