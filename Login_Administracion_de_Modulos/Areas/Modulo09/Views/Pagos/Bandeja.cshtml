@model Login_Administracion_de_Modulos.Areas.Modulo09.Controllers.ModeloBandejaPagosVista
@{
    ViewData["Title"] = "Bandeja de Vouchers";
    var rolActivo = User.FindFirst("ActiveRole")?.Value ?? "";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="bg-white dark:bg-[#111827] rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800 shadow-sm">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/50 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl shrink-0">🧾</div>
            <div>
                <h1 class="text-lg sm:text-xl font-black text-slate-900 dark:text-slate-100 tracking-tight">Bandeja de Vouchers</h1>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Validación de vouchers de pago. La foto del carné la valida Secretaría Académica.</p>
            </div>
        </div>
    </div>

    <!-- Métricas -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Por validar</span>
            <div class="text-xl font-bold text-amber-600 dark:text-amber-400 mt-1">@Model.Resumen.PorValidar</div>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Validados</span>
            <div class="text-xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">@Model.Resumen.Validados</div>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Rechazados</span>
            <div class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1">@Model.Resumen.Rechazados</div>
        </div>
        <div class="bg-white dark:bg-[#111827] rounded-2xl p-4 border border-slate-200/80 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Recaudación validada</span>
            <div class="text-xl font-bold text-slate-900 dark:text-slate-100 mt-1 font-mono">S/ @Model.Resumen.Recaudado.ToString("0.00")</div>
        </div>
    </div>

    <!-- Filtro -->
    <form method="get" class="flex gap-2 items-center">
        <select name="voucher" class="select select-sm select-bordered rounded-xl dark:bg-slate-800 text-xs">
            <option value="">Todos los vouchers</option>
            @foreach (var e in new[] { "Pendiente", "Validado", "Rechazado" })
            {
                <option value="@e" selected="@(Model.FiltroVoucher == e)">@e</option>
            }
        </select>
        <button type="submit" class="btn btn-outline btn-sm rounded-xl text-xs">Filtrar</button>
    </form>

    <!-- Bandeja -->
    <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-5">
        <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider mb-3">🧾 Vouchers</h2>
        @if (!Model.Pagos.Any())
        {
            <p class="text-xs text-slate-400 italic">Sin pagos en la bandeja.</p>
        }
        else
        {
            <div class="space-y-2">
                @foreach (var p in Model.Pagos)
                {
                    <div class="flex items-center gap-3 rounded-xl p-3
                        @(p.VoucherEstado == "Pendiente" ? "bg-amber-50 dark:bg-amber-950/30" : p.VoucherEstado == "Rechazado" ? "bg-rose-50 dark:bg-rose-950/30" : "bg-slate-50 dark:bg-slate-900/50")">
                        <span class="text-lg">🧾</span>
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-bold text-slate-900 dark:text-slate-100 font-mono">@p.Codigo — @p.Estudiante <span class="text-slate-400 font-sans">(@p.CodigoEstudiante)</span></div>
                            <div class="text-[11px] text-slate-500 dark:text-slate-400">
                                S/ @p.Monto.ToString("0.00") · @p.ConceptoCodigo @p.ConceptoNombre · @p.TipoPago · @p.FechaPago.ToString("dd/MM/yyyy")
                                @if (p.VoucherEstado == "Pendiente")
                                {
                                    <span class="badge badge-warning badge-xs font-semibold text-white ml-1">Pendiente</span>
                                }
                                else if (p.VoucherEstado == "Rechazado")
                                {
                                    <span class="badge badge-error badge-xs font-semibold text-white ml-1">Rechazado</span>
                                }
                                else
                                {
                                    <span class="badge badge-success badge-xs font-semibold text-white ml-1">Aprobado</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.MotivoRechazo))
                            {
                                <div class="text-[11px] text-rose-600 dark:text-rose-400 mt-1 bg-rose-100 dark:bg-rose-950/50 rounded-lg px-2 py-1">⚠️ @p.MotivoRechazo</div>
                            }
                        </div>
                        @if (p.VoucherEstado == "Pendiente" && (string.Equals(rolActivo, "Tesoreria", System.StringComparison.OrdinalIgnoreCase) || string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase)))
                        {
                            <div class="flex gap-1">
                                @if (p.TieneVoucher)
                                {
                                    <a href="/Modulo09/Pagos/Voucher/@p.Id" target="_blank"
                                       class="btn btn-outline btn-xs rounded-lg font-bold" title="Ver el voucher PDF subido por el estudiante">📄 Ver PDF</a>
                                }
                                <form method="post" asp-action="Validar" asp-route-id="@p.Id">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="aprobar" value="true" />
                                    <button type="submit" class="btn btn-success btn-xs rounded-xl font-bold">Aprobar</button>
                                </form>
                                <button type="button" class="btn btn-error btn-xs rounded-xl"
                                        onclick="document.getElementById('rech_@p.Id').classList.toggle('hidden')">Rechazar</button>
                                <form method="post" asp-action="Validar" asp-route-id="@p.Id" id="rech_@p.Id" class="hidden flex gap-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="aprobar" value="false" />
                                    <input type="text" name="motivo" class="input input-xs input-bordered rounded-xl dark:bg-slate-800" placeholder="Motivo del rechazo" required />
                                    <button type="submit" class="btn btn-error btn-xs rounded-xl">Enviar</button>
                                </form>
                            </div>
                        }
                        else if (p.VoucherEstado != "Pendiente")
                        {
                            @if (p.TieneVoucher && (string.Equals(rolActivo, "Tesoreria", System.StringComparison.OrdinalIgnoreCase) || string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase)))
                            {
                                <a href="/Modulo09/Pagos/Voucher/@p.Id" target="_blank"
                                   class="btn btn-ghost btn-xs rounded-lg font-bold text-slate-500" title="Ver el voucher PDF subido por el estudiante">📄 Ver PDF</a>
                            }
                            <span class="text-slate-400 text-[11px]">Resuelto · intentos: @p.Intentos</span>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Recibo directo de caja (Tesorería) -->
    @if (string.Equals(rolActivo, "Tesoreria", System.StringComparison.OrdinalIgnoreCase) || string.Equals(rolActivo, "Admin", System.StringComparison.OrdinalIgnoreCase))
    {
        <div class="bg-white dark:bg-[#111827] rounded-2xl border border-slate-200/80 dark:border-slate-800 shadow-sm p-6">
            <h2 class="text-xs font-bold text-slate-800 dark:text-slate-200 uppercase tracking-wider mb-4">💰 Registrar recibo directo</h2>
            <form method="post" asp-action="EmitirRecibo">
                @Html.AntiForgeryToken()
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div>
                        <label class="text-[11px] font-bold block mb-1">Estudiante *</label>
                        <select name="estudianteId" class="select select-sm select-bordered w-full rounded-xl dark:bg-slate-800 text-xs" required>
                            @foreach (var e in Model.FormRecibo.Estudiantes)
                            {
                                <option value="@e.Id">@e.CodigoEstudiante — @e.NombreCompleto</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="text-[11px] font-bold block mb-1">Concepto *</label>
                        <select name="concepto" class="select select-sm select-bordered w-full rounded-xl dark:bg-slate-800 text-xs" required>
                            @foreach (var c in Model.FormRecibo.Conceptos)
                            {
                                <option value="@c.Codigo">@c.Codigo · @c.Nombre (S/ @c.Monto.ToString("0.00"))</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="text-[11px] font-bold block mb-1">Medio (caja) *</label>
                        <select name="tipoPago" class="select select-sm select-bordered w-full rounded-xl dark:bg-slate-800 text-xs">
                            @foreach (var t in Model.FormRecibo.TiposPago)
                            {
                                <option value="@t.Codigo">@t.Nombre</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="text-[11px] font-bold block mb-1">Monto S/ *</label>
                        <input type="number" step="0.01" min="0.01" name="monto" class="input input-sm input-bordered w-full rounded-xl dark:bg-slate-800 text-xs" required placeholder="0.00" />
                    </div>
                </div>
                <div class="flex justify-end mt-4">
                    <button type="submit" class="btn btn-primary btn-sm rounded-xl font-bold">Emitir recibo</button>
                </div>
            </form>
        </div>
    }
</div>


