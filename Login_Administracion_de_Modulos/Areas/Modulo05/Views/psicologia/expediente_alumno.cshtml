@model List<Login_Administracion_de_Modulos.Areas.Modulo05.Models.SesionPsicologicaItem>
@{
    bool isPartial = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" || Context.Request.Query["partial"] == "true";
    if (!isPartial)
    {
        Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    }
    else
    {
        Layout = null;
    }
    ViewData["Title"] = "Expediente Confidencial del Alumno";
    ViewData["Role"] = "Bienestar Estudiantil";
}

<div class="page-header" style="margin-bottom: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-size: 2rem; font-weight: 800; background: linear-gradient(90deg, #6366f1, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0 0 0.5rem 0;">
                Expediente Psicológico Histórico
            </h1>
            <p style="color: var(--text-secondary); margin: 0;">Registro acumulado de orientaciones, evolución diagnóstica y acuerdos de bienestar</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            @if (!string.IsNullOrEmpty(ViewBag.DniBuscado as string))
            {
                <a href="/Modulo05/Psicologia/FormSesion?dni=@ViewBag.DniBuscado" class="btn btn-primary" style="background: linear-gradient(135deg, #10b981, #059669); border: none; color: white; padding: 0.75rem 1.25rem; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                    <i class="ph-bold ph-plus-circle"></i> Nueva Sesión (DNI: @ViewBag.DniBuscado)
                </a>
            }
            <a href="/Modulo05/Psicologia/FormSesion" class="btn btn-primary" style="background: linear-gradient(135deg, #6366f1, #a855f7); border: none; color: white; padding: 0.75rem 1.25rem; border-radius: 10px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem;">
                <i class="ph-bold ph-plus"></i> Nueva Sesión
            </a>
        </div>
    </div>
</div>

<!-- Buscador de Expediente por DNI -->
<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.5rem; margin-bottom: 2rem;">
    <form id="formBuscarExpediente" method="get" action="/Modulo05/Psicologia/ExpedienteAlumno" onsubmit="buscarExpedienteSubmit(event)" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
        <label for="dni" style="color: #fff; font-weight: 600; font-size: 0.95rem;">Buscar Alumno (DNI):</label>
        <input type="text" id="dni" name="dni" value="@(ViewBag.DniBuscado ?? "")" placeholder="Ingrese 8 dígitos de DNI..." maxlength="8" style="background: rgba(15,15,20,0.8); border: 1px solid var(--border-glass); color: #fff; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.95rem; width: 260px;" required />
        <button type="submit" id="btnBuscarExpediente" style="background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 0.5rem;">
            <i class="ph-bold ph-lock-key"></i> Abrir Expediente
        </button>
        @if (!string.IsNullOrEmpty(ViewBag.DniBuscado as string))
        {
            <a href="/Modulo05/Psicologia/ExpedienteAlumno" onclick="limpiarExpedienteFiltro(event)" style="color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; margin-left: 0.5rem;">Limpiar filtro</a>
        }
    </form>
</div>

<!-- Vista del Expediente -->
<div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 1.75rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0; display: flex; align-items: center; gap: 0.6rem;">
            <i class="ph ph-shield-check" style="color: #6366f1;"></i> Sesiones del Expediente Confidencial
            @if (!string.IsNullOrEmpty(ViewBag.DniBuscado as string))
            {
                <span style="font-size: 0.9rem; color: #a855f7; font-weight: 600;">(DNI: @ViewBag.DniBuscado)</span>
            }
        </h3>
        <button type="button" onclick="window.print()" style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 0.5rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
            <i class="ph ph-printer"></i> Imprimir Expediente
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            @foreach (var s in Model)
            {
                <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-glass); border-left: 4px solid #6366f1; border-radius: 12px; padding: 1.25rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
                        <div>
                            <span style="color: #c7d2fe; font-weight: 700; font-size: 0.95rem;">Sesión del @s.FechaHora.ToString("dd/MM/yyyy HH:mm")</span>
                            <small style="color: var(--text-secondary); margin-left: 0.75rem;">Estudiante: @s.EstudianteNombres @s.EstudianteApellidos (DNI: @s.NumeroDocumento)</small>
                        </div>
                        <span style="background: rgba(168,85,247,0.2); color: #c084fc; padding: 0.25rem 0.7rem; border-radius: 6px; font-weight: 600; font-size: 0.85rem;">
                            @(s.EstadoAtencion ?? "Registrado")
                        </span>
                    </div>

                    <div style="margin-top: 0.75rem;">
                        <strong style="color: #e2e8f0; font-size: 0.9rem;">Motivo de Consulta:</strong>
                        <p style="color: #cbd5e1; margin: 0.25rem 0 0.75rem 0; font-size: 0.95rem;">@s.MotivoConsulta</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(s.ObservacionNotas))
                    {
                        <div style="background: rgba(0,0,0,0.3); border-radius: 8px; padding: 0.85rem; margin-top: 0.5rem;">
                            <strong style="color: #94a3b8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">Notas Confidenciales y Acuerdos:</strong>
                            <p style="color: #f1f5f9; margin: 0.3rem 0 0 0; font-size: 0.9rem; line-height: 1.5; white-space: pre-line;">@s.ObservacionNotas</p>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align: center; padding: 3rem 1rem; color: var(--text-secondary);">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(255,255,255,0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem auto; font-size: 2rem; color: var(--text-muted);">
                <i class="ph ph-lock-key"></i>
            </div>
            <h4 style="color: #fff; font-size: 1.1rem; margin-bottom: 0.5rem;">Expediente Protegido o Sin Registros</h4>
            <p style="font-size: 0.95rem; margin: 0;">Ingrese el número de DNI del alumno para consultar su historial de sesiones y acuerdos confidenciales.</p>
        </div>
    }
</div>

<script>
    function buscarExpedienteSubmit(e) {
        const dni = document.getElementById('dni').value.trim();
        const container = document.getElementById('view-expediente-container');

        // Si estamos embebidos en el Dashboard SPA, cargamos vía fetch para no recargar la página entera
        if (container) {
            e.preventDefault();
            container.innerHTML = `
                <div style="padding: 3rem; text-align: center; color: var(--text-secondary);">
                    <i class="ph ph-spinner ph-spin" style="font-size: 2.5rem; color: #a855f7; margin-bottom: 1rem; display: block;"></i>
                    <p>Consultando expediente del alumno en la base de datos...</p>
                </div>
            `;
            fetch(`/Modulo05/Psicologia/ExpedienteAlumno?dni=${encodeURIComponent(dni)}&partial=true`, {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                const scripts = container.querySelectorAll('script');
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                    newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });
            })
            .catch(err => {
                alert('Error al consultar expediente: ' + err.message);
            });
        }
    }

    function limpiarExpedienteFiltro(e) {
        const container = document.getElementById('view-expediente-container');
        if (container) {
            e.preventDefault();
            fetch('/Modulo05/Psicologia/ExpedienteAlumno?partial=true', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
                const scripts = container.querySelectorAll('script');
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                    newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });
            });
        }
    }
</script>
