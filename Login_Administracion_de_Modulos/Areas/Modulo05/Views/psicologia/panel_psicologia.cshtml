    // ----------------------------------------------------
    // CONTROL DE PESTAÑAS (AGENDA / HISTORIAL)
    // ----------------------------------------------------
    function cambiarPestana(tipo) {
        const secAgenda = document.getElementById('seccion-agenda');
        const secHistorial = document.getElementById('seccion-historial');
        const btnAgenda = document.getElementById('tab-btn-agenda');
        const btnHistorial = document.getElementById('tab-btn-historial');

        btnAgenda.classList.remove('active');
        btnHistorial.classList.remove('active');

        if (tipo === 'agenda') {
            secAgenda.style.display = 'block';
            secHistorial.style.display = 'none';
            btnAgenda.classList.add('active');
        } else if (tipo === 'historial') {
            secAgenda.style.display = 'none';
            secHistorial.style.display = 'block';
            btnHistorial.classList.add('active');
        }
    }

    // ----------------------------------------------------
    // RENDERIZADO Y FILTRADO: AGENDA DE CITAS (TABLA)
    // ----------------------------------------------------
    function renderizarAgenda(lista = listaAgenda) {
