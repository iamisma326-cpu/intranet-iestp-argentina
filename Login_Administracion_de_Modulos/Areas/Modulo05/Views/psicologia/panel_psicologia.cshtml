        renderizarAgenda();
        renderizarHistorial();
        actualizarMetricas();
        cargarDatosDesdeServidor();
    }

    function cargarDatosDesdeServidor() {
        // 1. Cargar todas las atenciones desde PostgreSQL (atenciones_psicologia)
        fetch('/Modulo05/Psicologia/ListarTodas?limite=150')
            .then(res => res.json())
            .then(data => {
                if (data.success && Array.isArray(data.data) && data.data.length > 0) {
                    listaHistorial = data.data;
                    const citasPendientes = data.data.filter(x => x.estado === 'Pendiente' || x.fecha === fechaHoyIso);
                    if (citasPendientes.length > 0) {
                        listaAgenda = citasPendientes;
                    }
                    renderizarAgenda();
                    renderizarHistorial();
                }
            })
            .catch(() => {});

        // 2. Cargar métricas en tiempo real desde PostgreSQL
        fetch('/Modulo05/Psicologia/Metricas')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const elSes = document.getElementById('metric-sesiones-mes');
                    if (elSes) elSes.textContent = `${data.sesionesMes} Sesiones`;
                    const elCas = document.getElementById('metric-seguimiento');
                    if (elCas) elCas.textContent = `${data.casosSeguimiento} Casos`;
                    const elCie = document.getElementById('metric-cierres');
                    if (elCie) elCie.textContent = `${data.cierresExitosos} Casos`;
                    const elHoy = document.getElementById('metric-citas-hoy');
                    if (elHoy) elHoy.textContent = data.citasHoy;
                }
            })
            .catch(() => {});
