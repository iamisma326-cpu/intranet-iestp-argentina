                    </span>
                </td>
                <td>
                    <div style="font-weight: 700; color: #fff;">${item.estudiante}</div>
                    <span style="font-size: 0.82rem; color: #a5b4fc;"><i class="ph ph-identification-card"></i> DNI: ${item.dni}</span>
                </td>
                <td>
                    <span style="font-size: 0.88rem; color: #e2e8f0;">${item.carrera}</span><br />
                    <span style="font-size: 0.78rem; color: var(--psy-text-muted);">${item.ciclo}</span>
                </td>
                <td style="max-width: 240px;">
                    <div style="font-weight: 600; color: #c7d2fe; font-size: 0.88rem;">${item.tipo}</div>
                    <span style="font-size: 0.78rem; color: var(--psy-text-muted); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${item.motivo}">
                        ${item.motivo}
                    </span>
                </td>
                <td>
                    <span style="font-size: 0.82rem; color: #cbd5e1; display: inline-flex; align-items: center; gap: 0.35rem;">
                        <i class="ph ph-map-pin" style="color: #38bdf8;"></i> ${item.modalidad}
                    </span>
                </td>
                <td>
                    <span class="psy-badge ${badgeClass}">${item.estado}</span>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                    <button type="button" class="psy-btn psy-btn-secondary" style="padding: 0.45rem 0.8rem; font-size: 0.82rem;" onclick="verDetalleCita(${item.id})" title="Ver detalle de la cita">
                        <i class="ph ph-eye"></i> Detalle
                    </button>
                    <button type="button" class="psy-btn" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); padding: 0.45rem 0.75rem; font-size: 0.82rem;" onclick="iniciarSesionDesdeCita('${item.dni}')" title="Atender sesión">
                        <i class="ph ph-arrow-square-out"></i>
                    </button>
                    <button type="button" class="psy-btn" style="background: rgba(16, 185, 129, 0.12); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.25); padding: 0.45rem 0.65rem; font-size: 0.82rem;" onclick="alternarConfirmacionCita(${item.id})" title="Confirmar o alternar estado">
                        <i class="ph-bold ph-check"></i>
                    </button>
                </td>
            `;
            tbody.appendChild(fila);
        });

        document.getElementById('agenda-resultado-conteo').textContent = `Mostrando ${lista.length} citas programadas`;
        document.getElementById('badge-total-agenda').textContent = listaAgenda.length;
    }

    function filtrarAgenda() {
        const texto = (document.getElementById('filtro-agenda-texto')?.value || '').toLowerCase().trim();
        const fecha = document.getElementById('filtro-agenda-fecha')?.value || '';
        const estado = document.getElementById('filtro-agenda-estado')?.value || '';

        const filtradas = listaAgenda.filter(item => {
            const coincideTexto = !texto ||
                item.estudiante.toLowerCase().includes(texto) ||
                item.dni.includes(texto) ||
                item.carrera.toLowerCase().includes(texto) ||
                item.motivo.toLowerCase().includes(texto);

            const coincideFecha = !fecha || item.fecha === fecha;
            const coincideEstado = !estado || item.estado === estado;

            return coincideTexto && coincideFecha && coincideEstado;
        });

        renderizarAgenda(filtradas);
    }

    function establecerFechaAgenda(opcion) {
        const inputFecha = document.getElementById('filtro-agenda-fecha');
        if (opcion === 'hoy') {
            inputFecha.value = fechaHoyIso;
        } else if (opcion === 'manana') {
            inputFecha.value = fechaMananaIso;
        }
        filtrarAgenda();
    }

    function limpiarFiltrosAgenda() {
        document.getElementById('filtro-agenda-texto').value = '';
        document.getElementById('filtro-agenda-fecha').value = '';
        document.getElementById('filtro-agenda-estado').value = '';
        filtrarAgenda();
    }

    // ----------------------------------------------------
    // RENDERIZADO Y FILTRADO: HISTORIAL DE CITAS Y SESIONES
    // ----------------------------------------------------
    function renderizarHistorial(lista = listaHistorial) {
        const tbody = document.getElementById('contenedor-historial-filas');
        if (!tbody) return;

        tbody.innerHTML = '';
        if (lista.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" style="text-align: center; padding: 3rem; color: var(--psy-text-muted);">
                        <i class="ph ph-folder-notch-open" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
                        No se encontraron registros de atenciones para los filtros seleccionados.
                    </td>
                </tr>
            `;
            document.getElementById('historial-resultado-conteo').textContent = 'Mostrando 0 atenciones registradas';
            return;
        }

        lista.forEach(item => {
            let badgeClass = 'psy-badge-proceso';
            if (item.estado === 'Dado de Alta') badgeClass = 'psy-badge-alta';
            else if (item.estado === 'Derivado externamente') badgeClass = 'psy-badge-derivado';
            else if (item.estado === 'Pendiente') badgeClass = 'psy-badge-pendiente';

            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td>
                    <strong style="color: #fff;">#AT-${item.id}</strong><br />
                    <span style="font-size: 0.82rem; color: var(--psy-text-muted);"><i class="ph ph-calendar"></i> ${item.fecha} ${item.hora}</span>
                </td>
                <td>
                    <div style="font-weight: 700; color: #fff;">${item.estudiante}</div>
                    <span style="font-size: 0.82rem; color: #a5b4fc;">DNI: ${item.dni}</span>
                </td>
                <td>
                    <span style="font-size: 0.88rem; color: #e2e8f0;">${item.carrera}</span><br />
                    <span style="font-size: 0.78rem; color: var(--psy-text-muted);">${item.ciclo}</span>
                </td>
                <td style="max-width: 280px;">
                    <div style="font-size: 0.88rem; color: #cbd5e1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${item.motivo}">
                        ${item.motivo}
                    </div>
                    <span style="font-size: 0.78rem; color: var(--psy-text-muted);">Atendido por: ${item.psicologo}</span>
                </td>
                <td>
                    <span class="psy-badge ${badgeClass}">${item.estado}</span>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                    <button type="button" class="psy-btn psy-btn-secondary" style="padding: 0.45rem 0.75rem; font-size: 0.8rem;" onclick="verDetalleHistorial(${item.id})" title="Ver ficha clínica">
                        <i class="ph ph-eye"></i> Ficha
                    </button>
                    <a href="/Modulo05/Psicologia/ExpedienteAlumno?dni=${item.dni}" class="psy-btn psy-btn-secondary" style="padding: 0.45rem 0.75rem; font-size: 0.8rem;" title="Ver expediente">
                        <i class="ph ph-folder-user"></i>
                    </a>
                </td>
            `;
            tbody.appendChild(fila);
        });

        document.getElementById('historial-resultado-conteo').textContent = `Mostrando ${lista.length} atenciones registradas`;
        document.getElementById('badge-total-historial').textContent = listaHistorial.length;
    }

    function filtrarHistorial() {
        const texto = (document.getElementById('filtro-historial-texto')?.value || '').toLowerCase().trim();
        const desde = document.getElementById('filtro-historial-desde')?.value || '';
        const hasta = document.getElementById('filtro-historial-hasta')?.value || '';
        const estado = document.getElementById('filtro-historial-estado')?.value || '';

        const filtradas = listaHistorial.filter(item => {
            const coincideTexto = !texto ||
                item.estudiante.toLowerCase().includes(texto) ||
                item.dni.includes(texto) ||
                item.carrera.toLowerCase().includes(texto) ||
                item.motivo.toLowerCase().includes(texto) ||
                (item.diagnostico && item.diagnostico.toLowerCase().includes(texto));

            const coincideDesde = !desde || item.fecha >= desde;
            const coincideHasta = !hasta || item.fecha <= hasta;
            const coincideEstado = !estado || item.estado === estado;

            return coincideTexto && coincideDesde && coincideHasta && coincideEstado;
        });

        renderizarHistorial(filtradas);
    }

    function limpiarFiltrosHistorial() {
        document.getElementById('filtro-historial-texto').value = '';
        document.getElementById('filtro-historial-desde').value = '';
        document.getElementById('filtro-historial-hasta').value = '';
        document.getElementById('filtro-historial-estado').value = '';
        filtrarHistorial();
    }

    // ----------------------------------------------------
    // OPERACIONES DE AGENDA & MODALES
    // ----------------------------------------------------
    function abrirModalAgendarCita() {
        document.getElementById('modal-agendar-cita').classList.add('active');
        document.getElementById('nueva-cita-dni').focus();
    }

    function cerrarModal(id) {
        document.getElementById(id).classList.remove('active');
    }

    function buscarEstudianteParaCita() {
        const dni = document.getElementById('nueva-cita-dni').value.trim();
        if (dni.length !== 8) {
            mostrarToast('Por favor ingrese un DNI válido de 8 dígitos');
            return;
        }

        // Consultar API del servidor si está disponible
        fetch(`/Modulo05/Psicologia/BuscarPaciente?dni=${dni}`)
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('nueva-cita-nombre').value = data.nombreCompleto || `${data.nombres} ${data.apellidos}`;
                    if (data.carrera) document.getElementById('nueva-cita-carrera').value = data.carrera;
                    if (data.cicloTurno) document.getElementById('nueva-cita-ciclo').value = data.cicloTurno;
                    mostrarToast('Datos del estudiante cargados desde el sistema');
                } else {
                    mostrarToast(data.message || 'DNI no encontrado en padrón. Puede ingresar datos manuales.');
                }
            })
            .catch(() => {
                mostrarToast('Consulta local: complete los datos del estudiante.');
            });
    }

    function guardarNuevaCita(e) {
        e.preventDefault();
        const dni = document.getElementById('nueva-cita-dni').value.trim();
        const nombre = document.getElementById('nueva-cita-nombre').value.trim();
        const carrera = document.getElementById('nueva-cita-carrera').value;
        const ciclo = document.getElementById('nueva-cita-ciclo').value;
        const fecha = document.getElementById('nueva-cita-fecha').value;
        const horaRaw = document.getElementById('nueva-cita-hora').value;
        const tipo = document.getElementById('nueva-cita-tipo').value;
        const modalidad = document.getElementById('nueva-cita-modalidad').value;
        const motivo = document.getElementById('nueva-cita-motivo').value.trim();

        // Formatear hora 12h
        let horaStr = horaRaw;
        const partesHora = horaRaw.split(':');
        if (partesHora.length === 2) {
            let h = parseInt(partesHora[0]);
            let ampm = h >= 12 ? 'PM' : 'AM';
            h = h % 12 || 12;
            let m = partesHora[1];
            horaStr = `${h.toString().padStart(2, '0')}:${m} ${ampm}`;
        }

        const nuevaCita = {
            id: Date.now(),
            fecha: fecha,
            hora: horaStr,
            horaRaw: horaRaw,
            estudiante: nombre,
            dni: dni,
            carrera: carrera,
            ciclo: ciclo,
            tipo: tipo,
            motivo: motivo,
            modalidad: modalidad,
            estado: 'Pendiente'
        };

        // Guardar directamente en PostgreSQL vía POST /Modulo05/Psicologia/AgendarCita
        const formData = new FormData();
        formData.append('dni', dni);
        formData.append('nombre', nombre);
        formData.append('fecha', fecha);
        formData.append('hora', horaRaw);
        formData.append('motivo', motivo);
        formData.append('modalidad', modalidad);
        formData.append('estado', 'Pendiente');

        fetch('/Modulo05/Psicologia/AgendarCita', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                if (data.id) nuevaCita.id = data.id;
                mostrarToast('¡Cita registrada exitosamente en la base de datos!');
                cargarDatosDesdeServidor();
            } else {
                mostrarToast('Guardado local: ' + (data.message || ''));
            }
        })
        .catch(() => {
            mostrarToast('Cita agendada en memoria local.');
        });

        listaAgenda.unshift(nuevaCita);
        guardarEstadoLocal();
        cerrarModal('modal-agendar-cita');
        document.getElementById('form-nueva-cita').reset();
        document.getElementById('nueva-cita-fecha').value = fechaHoyIso;

        renderizarAgenda();
        actualizarMetricas();
    }

    function alternarConfirmacionCita(id) {
        const item = listaAgenda.find(x => x.id === id);
        if (!item) return;

        let nuevoEstado = 'Pendiente';
        if (item.estado === 'Confirmado') nuevoEstado = 'En proceso';
        else if (item.estado === 'En proceso') nuevoEstado = 'Pendiente';
        else nuevoEstado = 'Confirmado';

        item.estado = nuevoEstado;

        // Si es un id de BD, sincronizar estado con PostgreSQL
        if (id && id < 100000000000) {
            const fd = new FormData();
            fd.append('idAtencion', id);
            fd.append('nuevoEstado', nuevoEstado === 'Confirmado' ? 'Pendiente' : nuevoEstado);
            fetch('/Modulo05/Psicologia/ActualizarEstado', { method: 'POST', body: fd }).catch(() => {});
        }

        guardarEstadoLocal();
        renderizarAgenda();
        actualizarMetricas();
        mostrarToast(`Estado de la cita actualizado a: ${item.estado}`);
    }

    function verDetalleCita(id) {
        const item = listaAgenda.find(x => x.id === id);
        if (!item) return;

        const cont = document.getElementById('detalle-cita-body');
        cont.innerHTML = `
            <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--psy-card-border); border-radius: 14px; padding: 1.25rem; margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <span style="font-size: 0.85rem; color: #818cf8; font-weight: 700;">
                        <i class="ph ph-calendar"></i> ${item.fecha} &bull; ${item.hora}
                    </span>
                    <span class="psy-badge psy-badge-${item.estado === 'Confirmado' ? 'confirmado' : (item.estado === 'En Espera' ? 'espera' : 'pendiente')}">${item.estado}</span>
                </div>
                <h3 style="color: #fff; margin: 0 0 0.4rem 0; font-size: 1.25rem;">${item.estudiante}</h3>
                <p style="color: var(--psy-text-muted); margin: 0; font-size: 0.9rem;">
                    <strong>DNI:</strong> ${item.dni} | <strong>Carrera:</strong> ${item.carrera} (${item.ciclo})
                </p>
            </div>

            <div style="margin-bottom: 1rem;">
                <strong style="color: #a5b4fc; font-size: 0.85rem; text-transform: uppercase;">Tipo de Consulta:</strong>
                <p style="color: #fff; margin: 0.2rem 0 0.8rem 0;">${item.tipo || 'Orientación Psicológica'}</p>

                <strong style="color: #a5b4fc; font-size: 0.85rem; text-transform: uppercase;">Modalidad / Espacio:</strong>
                <p style="color: #fff; margin: 0.2rem 0 0.8rem 0;"><i class="ph ph-map-pin"></i> ${item.modalidad || 'Presencial (Consultorio 02)'}</p>

                <strong style="color: #a5b4fc; font-size: 0.85rem; text-transform: uppercase;">Motivo y Observaciones:</strong>
                <p style="color: #cbd5e1; margin: 0.2rem 0; background: rgba(0,0,0,0.25); padding: 0.85rem; border-radius: 8px; border: 1px solid rgba(255,255,255,0.05); font-size: 0.92rem;">
                    ${item.motivo}
                </p>
            </div>
        `;

        const acciones = document.getElementById('detalle-cita-acciones-estado');
        acciones.innerHTML = `
            <button type="button" class="psy-btn psy-btn-secondary" style="font-size: 0.85rem;" onclick="cambiarEstadoCitaModal(${item.id}, 'Confirmado')">
                <i class="ph-bold ph-check"></i> Confirmar
            </button>
            <button type="button" class="psy-btn psy-btn-secondary" style="font-size: 0.85rem;" onclick="cambiarEstadoCitaModal(${item.id}, 'En proceso')">
                <i class="ph-bold ph-calendar"></i> En Proceso
            </button>
            <button type="button" class="psy-btn" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); font-size: 0.85rem;" onclick="cancelarCitaModal(${item.id})">
                <i class="ph-bold ph-x"></i> Cancelar
            </button>
        `;

        document.getElementById('modal-detalle-cita').classList.add('active');
    }

    function cambiarEstadoCitaModal(id, nuevoEstado) {
        const item = listaAgenda.find(x => x.id === id);
        if (item) {
            item.estado = nuevoEstado;

            if (id && id < 100000000000) {
                const fd = new FormData();
                fd.append('idAtencion', id);
                fd.append('nuevoEstado', nuevoEstado === 'Confirmado' ? 'Pendiente' : nuevoEstado);
                fetch('/Modulo05/Psicologia/ActualizarEstado', { method: 'POST', body: fd }).catch(() => {});
            }

            guardarEstadoLocal();
            renderizarAgenda();
            actualizarMetricas();
            cerrarModal('modal-detalle-cita');
            mostrarToast(`Cita actualizada a estado: ${nuevoEstado}`);
        }
    }

    function cancelarCitaModal(id) {
        if (confirm('¿Está seguro de que desea cancelar esta cita de la agenda?')) {
            if (id && id < 100000000000) {
                const fd = new FormData();
                fd.append('idAtencion', id);
                fetch('/Modulo05/Psicologia/EliminarAtencion', { method: 'POST', body: fd }).catch(() => {});
            }

            listaAgenda = listaAgenda.filter(x => x.id !== id);
            guardarEstadoLocal();
            renderizarAgenda();
            actualizarMetricas();
            cerrarModal('modal-detalle-cita');
            mostrarToast('Cita cancelada y removida de la agenda');
        }
    }

    function iniciarSesionDesdeCita(dni) {
        if (window.parent && typeof window.parent.cargarSesionPsico === 'function') {
            window.parent.cargarSesionPsico();
            setTimeout(() => {
                const dniInput = document.getElementById('dniBusqueda');
                if (dniInput) {
                    dniInput.value = dni;
                    if (typeof buscarAlumnoDni === 'function') buscarAlumnoDni();
                }
            }, 300);
        } else {
            window.location.href = `/Modulo05/Psicologia/FormSesion?dni=${dni}`;
        }
    }

    // ----------------------------------------------------
    // OPERACIONES DE HISTORIAL & MODALES
    // ----------------------------------------------------
    function verDetalleHistorial(id) {
        const item = listaHistorial.find(x => x.id === id);
        if (!item) return;

        const cont = document.getElementById('detalle-historial-body');
        cont.innerHTML = `
            <div style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--psy-card-border); border-radius: 14px; padding: 1.25rem; margin-bottom: 1.25rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                    <span style="font-size: 0.85rem; color: #a855f7; font-weight: 700;">
                        <i class="ph ph-calendar"></i> Sesión del ${item.fecha} &bull; ${item.hora}
                    </span>
                    <span class="psy-badge psy-badge-${item.estado === 'Dado de Alta' ? 'alta' : (item.estado === 'Derivado externamente' ? 'derivado' : 'proceso')}">${item.estado}</span>
                </div>
                <h3 style="color: #fff; margin: 0 0 0.4rem 0; font-size: 1.25rem;">${item.estudiante}</h3>
                <p style="color: var(--psy-text-muted); margin: 0; font-size: 0.9rem;">
                    <strong>DNI:</strong> ${item.dni} | <strong>Carrera:</strong> ${item.carrera} (${item.ciclo})
                </p>
                <p style="color: #a5b4fc; font-size: 0.85rem; margin: 0.4rem 0 0 0;">
                    <i class="ph ph-user"></i> Especialista a cargo: <strong>${item.psicologo}</strong>
                </p>
            </div>

            <div style="margin-bottom: 1.25rem;">
                <strong style="color: #c084fc; font-size: 0.85rem; text-transform: uppercase;">Motivo de Consulta y Contexto:</strong>
                <p style="color: #f1f5f9; margin: 0.35rem 0 1rem 0; font-size: 0.95rem; line-height: 1.5;">
                    ${item.motivo}
                </p>

                <strong style="color: #c084fc; font-size: 0.85rem; text-transform: uppercase;">Diagnóstico / Observaciones Clínicas y Acuerdos:</strong>
                <div style="margin-top: 0.35rem; background: rgba(99, 102, 241, 0.08); border-left: 4px solid #818cf8; padding: 1rem; border-radius: 0 10px 10px 0; color: #cbd5e1; font-size: 0.92rem; line-height: 1.6;">
                    ${item.diagnostico || 'Notas de evolución reservadas conforme a confidencialidad médica.'}
                </div>
            </div>
        `;

        document.getElementById('link-expediente-alumno-modal').href = `/Modulo05/Psicologia/ExpedienteAlumno?dni=${item.dni}`;
        document.getElementById('modal-detalle-historial').classList.add('active');
    }

    function exportarHistorialCSV() {
        if (listaHistorial.length === 0) {
            mostrarToast('No hay registros en el historial para exportar');
            return;
        }

        let csv = 'Folio,Fecha,Hora,Estudiante,DNI,Carrera,Motivo,Estado,Psicologo\n';
        listaHistorial.forEach(h => {
            const motivoEscapado = `"${(h.motivo || '').replace(/"/g, '""')}"`;
            csv += `AT-${h.id},${h.fecha},${h.hora},"${h.estudiante}",${h.dni},"${h.carrera}",${motivoEscapado},"${h.estado}","${h.psicologo}"\n`;
        });

        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.setAttribute('href', url);
        link.setAttribute('download', `historial_psicologia_${fechaHoyIso}.csv`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        mostrarToast('Reporte del historial descargado en CSV');
    }

    // ----------------------------------------------------
    // ACTUALIZACIÓN DE MÉTRICAS Y NOTIFICACIONES
    // ----------------------------------------------------
    function actualizarMetricas() {
        const citasHoy = listaAgenda.filter(x => x.fecha === fechaHoyIso);
        const elCitasHoy = document.getElementById('metric-citas-hoy');
        if (elCitasHoy) elCitasHoy.textContent = citasHoy.length;

        const altas = listaHistorial.filter(x => x.estado === 'Dado de Alta').length;
        const elAltas = document.getElementById('metric-cierres');
        if (elAltas) elAltas.textContent = `${altas} Casos`;
    }

    function mostrarToast(mensaje) {
        const toast = document.getElementById('psy-toast');
        const msg = document.getElementById('psy-toast-msg');
        if (!toast || !msg) return;

        msg.textContent = mensaje;
        toast.classList.add('show');
        setTimeout(() => {
            toast.classList.remove('show');
        }, 3200);
    }
</script>
