            const esHoy = item.fecha === fechaHoyIso;
            let badgeClass = 'psy-badge-pendiente';
            if (item.estado === 'Confirmado') badgeClass = 'psy-badge-confirmado';
            else if (item.estado === 'En Espera') badgeClass = 'psy-badge-espera';
            else if (item.estado === 'Reprogramado') badgeClass = 'psy-badge-proceso';

            const fila = document.createElement('tr');
            fila.innerHTML = `
                <td>
                    <strong style="color: #fff; font-size: 0.95rem;">${item.hora}</strong><br />
                    <span style="font-size: 0.8rem; color: ${esHoy ? '#818cf8; font-weight: 700;' : 'var(--psy-text-muted);'}">
