@{
    Layout = null;
    ViewData["Title"] = "Panel de Psicología y Bienestar";
}

<!-- Estilos integrados para el Panel de Psicología -->
<style>
    :root {
        --psy-card-bg: #111827;
        --psy-card-border: rgba(255, 255, 255, 0.08);
        --psy-card-hover: rgba(255, 255, 255, 0.12);
        --psy-primary: #6366f1;
        --psy-primary-end: #a855f7;
        --psy-primary-grad: linear-gradient(135deg, #6366f1, #a855f7);
        --psy-text-light: #f8fafc;
        --psy-text-muted: #94a3b8;
        --psy-success: #10b981;
        --psy-warning: #f59e0b;
        --psy-info: #06b6d4;
        --psy-danger: #ef4444;
    }

    .psy-panel-wrapper {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--psy-text-light);
        max-width: 1400px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    /* Tarjetas de Estadísticas */
    .psy-metric-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2rem;
    }

    .psy-metric-card {
        background-color: var(--psy-card-bg);
        border: 1px solid var(--psy-card-border);
        border-radius: 16px;
        padding: 1.35rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1.1rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .psy-metric-card:hover {
        transform: translateY(-3px);
        border-color: rgba(99, 102, 241, 0.4);
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.15);
    }

    .psy-metric-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        flex-shrink: 0;
    }

    /* Pestañas de Navegación */
    .psy-tab-navigation {
        display: flex;
        gap: 0.5rem;
        background: rgba(15, 23, 42, 0.7);
        padding: 0.4rem;
        border-radius: 14px;
        border: 1px solid var(--psy-card-border);
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
    }

    .psy-tab-btn {
        background: transparent;
        border: none;
        color: var(--psy-text-muted);
        padding: 0.75rem 1.4rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        transition: all 0.2s ease;
    }

    .psy-tab-btn:hover {
        color: #fff;
        background: rgba(255, 255, 255, 0.05);
    }

    .psy-tab-btn.active {
        background: var(--psy-primary-grad);
        color: #fff;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
    }

    .psy-tab-counter {
        background: rgba(255, 255, 255, 0.2);
        padding: 0.15rem 0.55rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    /* Barra de Búsqueda y Filtros */
    .psy-filter-card {
        background: var(--psy-card-bg);
        border: 1px solid var(--psy-card-border);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .psy-filter-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.85rem;
        align-items: center;
        justify-content: space-between;
    }

    .psy-filter-inputs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        flex: 1;
    }

    .psy-input-wrapper {
        position: relative;
        flex: 1;
        min-width: 240px;
    }

    .psy-input-wrapper i {
        position: absolute;
        left: 0.9rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--psy-text-muted);
        font-size: 1.1rem;
    }

    .psy-input {
        width: 100%;
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid var(--psy-card-border);
        color: #fff;
        padding: 0.65rem 0.9rem 0.65rem 2.4rem;
        border-radius: 10px;
        font-size: 0.9rem;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .psy-input:focus {
        border-color: var(--psy-primary);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
    }

    .psy-select {
        background: rgba(15, 23, 42, 0.85);
        border: 1px solid var(--psy-card-border);
        color: #fff;
        padding: 0.65rem 1rem;
        border-radius: 10px;
        font-size: 0.9rem;
        outline: none;
        cursor: pointer;
        min-width: 150px;
    }

    .psy-select:focus {
        border-color: var(--psy-primary);
    }

    .psy-btn {
        padding: 0.65rem 1.2rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border: none;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .psy-btn-primary {
        background: var(--psy-primary-grad);
        color: #fff;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
    }

    .psy-btn-primary:hover {
        opacity: 0.92;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(99, 102, 241, 0.45);
    }

    .psy-btn-secondary {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid var(--psy-card-border);
        color: #fff;
    }

    .psy-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.14);
        border-color: rgba(255, 255, 255, 0.25);
    }

    /* Badges de Estado */
    .psy-badge {
        padding: 0.35rem 0.75rem;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        letter-spacing: 0.3px;
    }

    .psy-badge-confirmado {
        background: rgba(16, 185, 129, 0.18);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.35);
    }

    .psy-badge-espera {
        background: rgba(6, 182, 212, 0.18);
        color: #38bdf8;
        border: 1px solid rgba(6, 182, 212, 0.35);
    }

    .psy-badge-pendiente {
        background: rgba(245, 158, 11, 0.18);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.35);
    }

    .psy-badge-alta {
        background: rgba(99, 102, 241, 0.18);
        color: #a5b4fc;
        border: 1px solid rgba(99, 102, 241, 0.35);
    }

    .psy-badge-proceso {
        background: rgba(168, 85, 247, 0.18);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.35);
    }

    .psy-badge-derivado {
        background: rgba(239, 68, 68, 0.18);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.35);
    }

    /* Grilla de Agenda */
    .psy-agenda-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
        gap: 1.25rem;
    }

    .psy-appointment-card {
        background: var(--psy-card-bg);
        border: 1px solid var(--psy-card-border);
        border-radius: 16px;
        padding: 1.35rem;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        transition: all 0.2s ease;
    }

    .psy-appointment-card:hover {
        border-color: rgba(99, 102, 241, 0.45);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        transform: translateY(-2px);
    }

    .psy-appointment-card.accent-today {
        border-left: 4px solid #6366f1;
    }

    .psy-appointment-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.85rem;
        gap: 0.5rem;
    }

    .psy-time-pill {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        padding: 0.25rem 0.65rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .psy-appointment-student {
        font-size: 1.05rem;
        font-weight: 700;
        color: #fff;
        margin: 0.25rem 0;
    }

    .psy-appointment-sub {
        font-size: 0.85rem;
        color: var(--psy-text-muted);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .psy-appointment-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1.1rem;
        padding-top: 0.9rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .psy-card-btn {
        flex: 1;
        padding: 0.55rem 0.75rem;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        text-decoration: none;
        transition: all 0.15s ease;
    }

    /* Tabla de Historial */
    .psy-table-container {
        background: var(--psy-card-bg);
        border: 1px solid var(--psy-card-border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .psy-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.92rem;
    }

    .psy-table thead {
        background: rgba(15, 23, 42, 0.85);
        border-bottom: 1px solid var(--psy-card-border);
    }

    .psy-table th {
        padding: 1rem 1.15rem;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--psy-text-muted);
    }

    .psy-table tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        transition: background-color 0.15s ease;
    }

    .psy-table tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.03);
    }

    .psy-table td {
        padding: 1rem 1.15rem;
        vertical-align: middle;
    }

    /* Modales */
    .psy-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: 1rem;
    }

    .psy-modal-overlay.active {
        display: flex;
    }

    .psy-modal-card {
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        width: 100%;
        max-width: 620px;
        max-height: 90vh;
        overflow-y: auto;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
        padding: 2rem;
        position: relative;
        animation: psyModalFadeIn 0.25s ease-out;
    }

    @@keyframes psyModalFadeIn {
        from {
            opacity: 0;
            transform: scale(0.96) translateY(10px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .psy-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .psy-modal-close {
        background: transparent;
        border: none;
        color: var(--psy-text-muted);
        font-size: 1.5rem;
        cursor: pointer;
        transition: color 0.2s;
    }

    .psy-modal-close:hover {
        color: #fff;
    }

    .psy-form-group {
        margin-bottom: 1.15rem;
    }

    .psy-form-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--psy-text-muted);
        margin-bottom: 0.4rem;
    }

    .psy-form-input, .psy-form-select, .psy-form-textarea {
        width: 100%;
        background: rgba(15, 23, 42, 0.95);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #fff;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        font-size: 0.95rem;
        outline: none;
        box-sizing: border-box;
    }

    .psy-form-input:focus, .psy-form-select:focus, .psy-form-textarea:focus {
        border-color: var(--psy-primary);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.3);
    }

    /* Toast Notification */
    .psy-toast {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        background: #1e1b4b;
        border: 1px solid #6366f1;
        color: #fff;
        padding: 1rem 1.4rem;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        z-index: 2000;
        transform: translateY(100px);
        opacity: 0;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .psy-toast.show {
        transform: translateY(0);
        opacity: 1;
    }
</style>

<div class="psy-panel-wrapper">
    <!-- Encabezado Principal -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1.25rem; margin-bottom: 2rem;">
        <div>
            <h1 style="font-size: 2.1rem; font-weight: 800; background: linear-gradient(90deg, #818cf8, #c084fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0 0 0.4rem 0;">
                Módulo de Psicología y Bienestar Estudiantil
            </h1>
            <p style="color: var(--psy-text-muted); margin: 0; font-size: 0.98rem;">
                Orientación psicológica, gestión de citas programadas e historial clínico confidencial del IESTP Argentina
            </p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <button type="button" class="psy-btn psy-btn-primary" onclick="abrirModalAgendarCita()">
                <i class="ph-bold ph-calendar-plus"></i> Agendar Cita
            </button>
            <a href="/Modulo05/Psicologia/FormSesion" onclick="if(window.cargarSesionPsico){ event.preventDefault(); cargarSesionPsico(); }" class="psy-btn psy-btn-secondary">
                <i class="ph-bold ph-plus-circle"></i> Registrar Sesión
            </a>
            <a href="/Modulo05/Psicologia/ExpedienteAlumno" onclick="if(window.cargarExpedientePsico){ event.preventDefault(); cargarExpedientePsico(); }" class="psy-btn psy-btn-secondary">
                <i class="ph-bold ph-folder-user"></i> Ver Expediente
            </a>
        </div>
    </div>

    <!-- Métricas Clave de Psicología -->
    <div class="psy-metric-grid">
        <div class="psy-metric-card">
            <div class="psy-metric-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8;">
                <i class="ph-fill ph-calendar-check"></i>
            </div>
            <div>
                <p style="font-size: 0.78rem; color: var(--psy-text-muted); text-transform: uppercase; font-weight: 700; margin: 0;">Citas en Agenda (Hoy)</p>
                <h3 id="metric-citas-hoy" style="font-size: 1.85rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">4</h3>
                <span style="font-size: 0.75rem; color: #34d399; font-weight: 600;">2 Confirmadas &bull; 2 En espera</span>
            </div>
        </div>

        <div class="psy-metric-card">
            <div class="psy-metric-icon" style="background: rgba(168, 85, 247, 0.15); color: #c084fc;">
                <i class="ph-fill ph-brain"></i>
            </div>
            <div>
                <p style="font-size: 0.78rem; color: var(--psy-text-muted); text-transform: uppercase; font-weight: 700; margin: 0;">Sesiones del Mes</p>
                <h3 id="metric-sesiones-mes" style="font-size: 1.85rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">28</h3>
                <span style="font-size: 0.75rem; color: #a5b4fc; font-weight: 600;">+6 respecto al mes anterior</span>
            </div>
        </div>

        <div class="psy-metric-card">
            <div class="psy-metric-icon" style="background: rgba(6, 182, 212, 0.15); color: #38bdf8;">
                <i class="ph-fill ph-users-three"></i>
            </div>
            <div>
                <p style="font-size: 0.78rem; color: var(--psy-text-muted); text-transform: uppercase; font-weight: 700; margin: 0;">Casos en Seguimiento</p>
                <h3 id="metric-casos-activos" style="font-size: 1.85rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">14 Alumnos</h3>
                <span style="font-size: 0.75rem; color: var(--psy-text-muted); font-weight: 600;">Plan terapéutico activo</span>
            </div>
        </div>

        <div class="psy-metric-card">
            <div class="psy-metric-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
                <i class="ph-fill ph-check-circle"></i>
            </div>
            <div>
                <p style="font-size: 0.78rem; color: var(--psy-text-muted); text-transform: uppercase; font-weight: 700; margin: 0;">Cierres Exitosos</p>
                <h3 id="metric-cierres" style="font-size: 1.85rem; font-weight: 800; color: #fff; margin: 0.2rem 0 0 0;">9 Casos</h3>
                <span style="font-size: 0.75rem; color: #34d399; font-weight: 600;">Dado de Alta formal</span>
            </div>
        </div>
    </div>

    <!-- Pestañas de Navegación Segmentada (Agenda vs Historial) -->
    <div class="psy-tab-navigation">
        <button type="button" class="psy-tab-btn active" id="tab-btn-agenda" onclick="cambiarPestana('agenda')">
            <i class="ph-bold ph-calendar"></i> Agenda de Citas Programadas
            <span class="psy-tab-counter" id="badge-total-agenda">4</span>
        </button>
        <button type="button" class="psy-tab-btn" id="tab-btn-historial" onclick="cambiarPestana('historial')">
            <i class="ph-bold ph-clock-counter-clockwise"></i> Historial Integral de Citas y Sesiones
            <span class="psy-tab-counter" id="badge-total-historial">8</span>
        </button>
    </div>

    <!-- ================= SECCIÓN 1: AGENDA DE CITAS ================= -->
    <section id="seccion-agenda">
        <!-- Barra de Búsquedas y Filtros para Agenda -->
        <div class="psy-filter-card">
            <div class="psy-filter-row">
                <div class="psy-filter-inputs">
                    <div class="psy-input-wrapper">
                        <i class="ph ph-magnifying-glass"></i>
                        <input type="text" id="filtro-agenda-texto" class="psy-input" placeholder="Buscar por Nombre, DNI o Carrera..." oninput="filtrarAgenda()" />
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.4rem;">
                        <input type="date" id="filtro-agenda-fecha" class="psy-input" style="padding-left: 0.9rem; min-width: 160px;" onchange="filtrarAgenda()" />
                        <button type="button" class="psy-btn psy-btn-secondary" style="padding: 0.65rem 0.85rem;" title="Filtrar Hoy" onclick="establecerFechaAgenda('hoy')">
                            Hoy
                        </button>
                        <button type="button" class="psy-btn psy-btn-secondary" style="padding: 0.65rem 0.85rem;" title="Filtrar Mañana" onclick="establecerFechaAgenda('manana')">
                            Mañana
                        </button>
                    </div>
                    <select id="filtro-agenda-estado" class="psy-select" onchange="filtrarAgenda()">
                        <option value="">Todos los Estados</option>
                        <option value="Confirmado">Confirmado</option>
                        <option value="En Espera">En Espera</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="Reprogramado">Reprogramado</option>
                    </select>
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <button type="button" class="psy-btn psy-btn-secondary" onclick="limpiarFiltrosAgenda()" title="Limpiar todos los filtros de agenda">
                        <i class="ph ph-arrow-counter-clockwise"></i> Limpiar
                    </button>
                    <button type="button" class="psy-btn psy-btn-primary" onclick="abrirModalAgendarCita()">
                        <i class="ph-bold ph-plus"></i> Nueva Cita
                    </button>
                </div>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.9rem; font-size: 0.85rem; color: var(--psy-text-muted);">
                <span id="agenda-resultado-conteo">Mostrando 4 citas programadas</span>
                <span style="font-size: 0.8rem;"><i class="ph-fill ph-circle" style="color: #6366f1; font-size: 0.6rem;"></i> Datos sincronizados con PostgreSQL</span>
            </div>
        </div>

        <!-- Tabla de Agenda de Citas -->
        <div class="psy-table-container">
            <div style="overflow-x: auto;">
                <table class="psy-table">
                    <thead>
                        <tr>
                            <th>Fecha y Hora</th>
                            <th>Estudiante &bull; DNI</th>
                            <th>Carrera / Ciclo</th>
                            <th>Tipo de Consulta</th>
                            <th>Modalidad</th>
                            <th>Estado</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="contenedor-agenda-filas">
                        <!-- Las filas se generan dinámicamente mediante JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- ================= SECCIÓN 2: HISTORIAL DE CITAS Y SESIONES ================= -->
    <section id="seccion-historial" style="display: none; margin-top: 1.5rem;">
        <!-- Barra de Búsquedas y Filtros para Historial -->
        <div class="psy-filter-card">
            <div class="psy-filter-row">
                <div class="psy-filter-inputs">
                    <div class="psy-input-wrapper">
                        <i class="ph ph-magnifying-glass"></i>
                        <input type="text" id="filtro-historial-texto" class="psy-input" placeholder="Buscar por Nombre, DNI, Motivo o Diagnóstico..." oninput="filtrarHistorial()" />
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.4rem;">
