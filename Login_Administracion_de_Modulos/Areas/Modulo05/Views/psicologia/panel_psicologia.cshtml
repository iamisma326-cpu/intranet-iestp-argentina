        if (!tbody) return;

        tbody.innerHTML = '';
        if (lista.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="7" style="text-align: center; padding: 3rem 1.5rem; color: var(--psy-text-muted);">
