# ==============================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - SISTEMA IESTP ARGENTINA
# ==============================================================
# Copie este archivo como .env en la raíz del proyecto para desarrollo local:
#   cp .env.example .env
# NUNCA suba el archivo .env real al repositorio (está en .gitignore).
# En producción (MonsterASP) el mismo archivo .env se publica al wwwroot
# del sitio mediante el workflow setup-env.yml (secrets de GitHub).

# 1. Base de Datos PostgreSQL (Neon)
#    Requisitos del proyecto:
#      - Sin MinPoolSize: el free tier de Neon da 100 CU-horas/mes y las
#        conexiones idle mantenidas vivas suspenden el compute a mitad de mes.
#      - MaxPoolSize moderado (10): el endpoint free acepta pocas conexiones
#        simultáneas y la RAM del hosting es limitada.
#      - SSL Mode=Require: Neon lo exige.
#    Formato (completar con los datos del panel de Neon):
# DB_CONNECTION_STRING=Host=EP-XXXX.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=USUARIO;Password=CONTRASEÑA;SSL Mode=Require;MaxPoolSize=10;

# 2. Credenciales de Google OAuth 2.0 (SSO Institucional)
#    Si se dejan comentadas, el login con Google queda deshabilitado
#    y la app arranca igual con DNI + contraseña.
# GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-tu-client-secret

# 3. Accesos rápidos demo (botones "Acceso Rápido" del login)
#    "true" los habilita TAMBIÉN en producción; cualquier otro valor los
#    deja solo para desarrollo. Es un flag del dueño del sitio: si algún día
#    el sistema pasa a uso real con datos sensibles, póngalo en false.
# ENABLE_DEMO_LOGIN=true
